test "a helper's chat opens read-only and its main chat keeps the draft"
  tap "sign-toggle"
  type "sign-name" "Ada"
  type "sign-email" "threads-1@example.com"
  type "sign-password" "correct horse"
  tap "sign-submit"
  clock data
  tap "new-dood"
  clock data
  clock settle
  clock data
  type "composer" "/tool subagent {\"action\":\"start\",\"title\":\"Flights\",\"task\":\"Find flights to Lisbon\"}"
  tap "send"
  clock data
  clock +5000 real
  type "composer" "Keep this in the main chat"
  tap "other-chats"
  tap "Flights"
  clock data
  expect tree has "thread-foot"
  expect tree missing "composer"
  expect text "thread-title" == "Flights"
  expect tree has "thread-parent"
  tap "main-chat-link"
  clock data
  expect text "composer" == "Keep this in the main chat"
