test "New team in account settings joins the workspace section list"
  size 1280x800
  tap "sign-toggle"
  type "sign-name" "Settings Owner"
  type "sign-email" "teams-settings@example.com"
  type "sign-password" "correct horse"
  tap "sign-submit"
  clock data
  tap "account"
  tap "account-settings"
  clock data
  clock settle
  tap "settings-go-workspacesList-account"
  clock data
  clock settle
  tap "workspaces-new-team"
  clock settle
  type "team-name" "Settings Studio"
  tap "team-create-submit"
  clock data
  tap "team-created-go"
  clock data
  clock settle
  tap "workspace-home-people"
  clock data
  clock settle
  expect tree has "settings-go-workspaceModels-people"
  expect tree has "settings-go-workspaceComputers-people"
  tap "settings-up-people"
  clock data
  clock settle
  expect state onRoute == "workspacesList"
  expect state workspaceList.length == 2
  resize 390x844
  tap "Settings Studio: workspace settings"
  clock data
  clock settle
  expect state onRoute == "workspaceSettings"
  expect tree has "settings-nav-people"
  tap "settings-go-people-people"
  clock data
  clock settle
  expect tree has "team-title-people"

test "a team Dood hatches from its workspace plus, and a quick New team keeps the first run out of its dialog"
  size 1280x800
  tap "sign-toggle"
  type "sign-name" "Hatch Owner"
  type "sign-email" "teams-hatch@example.com"
  type "sign-password" "correct horse"
  tap "sign-submit"
  clock data
  tap "new-team"
  clock +1000
  expect state welcomeOn == false
  type "team-name" "Hatch Studio"
  tap "team-create-submit"
  clock data
  tap "team-created-go"
  clock data
  clock settle
  tap "New Dood in Hatch Studio"
  clock data
  clock settle
  clock data
  expect state onRoute == "dood"
  expect state welcomeOn == false
  expect state openDood.hatched == false
  clock +1700
  expect state liveFaces.0 .hatching == true
  // Start another while this one's animation is still playing. The new one must hatch too.
  tap "New Dood in Hatch Studio"
  clock data
  clock settle
  clock +1700
  clock data
  expect state liveFaces.0 .hatching == true
  expect state liveFaces.1 .hatched == true
  tap "panel-toggle-dood"
  expect text "panel-status" == "About to hatch"
  tap "panel-face"
  clock data
  expect state openDood.hatched == true
  expect text "panel-status" == "Ready"
  reload
  clock data
  clock settle
  clock data
  expect state openDood.hatched == true
  expect state workspaceList.length == 2

test "in a team, its presence socket says who is here and where, and the panel says who has the chat open"
  size 1280x800
  tap "sign-toggle"
  type "sign-name" "Here Owner"
  type "sign-email" "teams-here@example.com"
  type "sign-password" "correct horse"
  tap "sign-submit"
  clock data
  tap "new-team"
  clock +1000
  type "team-name" "Here Studio"
  tap "team-create-submit"
  clock data
  tap "team-created-go"
  clock data
  clock settle
  tap "New Dood in Here Studio"
  clock data
  clock settle
  clock data
  clock +500 real
  clock data
  expect state herePlaces.length == 1
  expect state herePlaces.0 .typing == false
  // Only someone else is shown with a Dood; the person themselves is in the panel's Here now.
  expect state hereOthers.length == 0
  tap "panel-toggle-dood"
  expect tree has "panel-here"
  expect state hereInChat.length == 1
  type "composer" "Hello th"
  clock +500 real
  clock data
  expect state herePlaces.0 .typing == true
  clock +4500 real
  clock data
  expect state herePlaces.0 .typing == false
