// PLACEHOLDER for the creature. Another piece of work draws it as the `do-creature` native view
// (modules/web/); when it lands, DoodFace's view becomes that view, taking the same props, and
// nothing that uses DoodFace changes. Until then a Dood is a rounded square in its colour with
// two eyes, which look up while it works and aside while it waits on someone.

component DoodFace
  props
    // What its features grow from, and its colour (a hex): AgentSummary's avatar, resolved.
    seed: string
    color: string
    // "idle", "working" or "asking".
    state: string
    // Its name, which a reader hears.
    name: string
    // Its width and height, in px.
    size: number
  derive look = state == "working" ? "flex-start" : state == "asking" ? "flex-end" : "center"
  view
    column width=size height=size flex-shrink=0 border-radius=(size * 0.36) background-color=color
      align-items="center" justify-content="center" role="img" aria-label=name
      row gap=(size * 0.12) margin-top=(size * -0.04) aria-hidden=true
        for eye in ["left", "right"] key=eye
          column width=(size * 0.22) height=(size * 0.26) border-radius=999 background-color="ink.on-color"
            align-items=look justify-content="center" padding=(size * 0.03)
            column width=(size * 0.11) height=(size * 0.13) border-radius=999 background-color="shade"
