use CallSend from "./call.contract"
use RunningCommands from "./composer-jobs.contract"
use Reply from "./shapes.contract"
use Composer, SendButton, IconButton, Menu, MenuItem, Field from "./styles.contract"
use ThreadsMenu, ThreadListing from "./threads.contract"

shape ComposerDraft
  key: string
  text: string

shape ComposerFile
  id: string
  name: string
  stored: bool
  mime: string
  data: string
  preview: string

shape ComposerUpload
  owner: string
  key: string
  files: ComposerFile[]
  error: string

shape ComposerModel
  id: string
  name: string
  facts: string
  source: string
  suggested: bool

shape ComposerConfig
  owner: string
  agentId: string
  model: string
  thinking: string
  levels: string[]
  models: ComposerModel[]
  more: number
  sees: bool

shape ComposerVoice
  key: string
  ticket: number
  text: string
  end: string
  error: string

members App
  // --- composer ---
  state composerDrafts: ComposerDraft[] = []
  derive composerKey = `${session.owner}:${openAgentId}:${openChatId}`
  derive draft = match first(composerDrafts.filter(d => d.key == composerKey)) { case some(d) => d.text, case none => "" }
  state composerFiles: ComposerFile[] = []
  state composerFilesKey = ""
  derive composerAttachments = composerFilesKey == composerKey ? composerFiles : []
  state composerUploadError = ""
  state composerSearch = ""
  resource composerConfig = loadComposer(session.owner, openAgentId, openDood.workspaceId, composerSearch) with pulse.changes as shape ComposerConfig else empty()
  derive composerSettings = composerConfig.owner == session.owner and composerConfig.agentId == openAgentId ? composerConfig : ComposerConfig(owner="", agentId="", model="", thinking="", levels=[], models=[], more=0, sees=false)
  mutation composerSaved as shape Reply refreshes composerConfig, doods
  mutation composerUploaded as shape ComposerUpload queue then composerAfterUpload
  mutation composerStopped as shape Reply
  mutation said as shape Reply then afterSay
  state composerRestAt = 0
  state composerSentKey = ""
  state composerSentText = ""
  state composerSentFiles: string[] = []
  derive sayError = pending(said) or composerSentKey != composerKey ? "" : match said { case some(r) => r.error, case none => "" }
  derive composerError = match composerSaved { case some(r) => r.error, case none => "" }
  derive composerStopError = match composerStopped { case some(r) => r.error, case none => "" }
  state composerVoiceTicket = 0
  state composerVoiceDone = 0
  task composerVoiceChat key=composerKey
    after(1, composerInvalidateVoice)
  action composerInvalidateVoice
    composerVoiceTicket = composerVoiceTicket + 1
  mutation composerTranscribed as shape ComposerVoice then composerAfterVoice

  action editDraft(v: string)
    composerDrafts = composerDrafts.filter(d => d.key != composerKey).concat([ComposerDraft(key=composerKey, text=v)])
  action composerRetryModels
    refresh composerConfig
  action composerFind(v: string)
    composerSearch = v
  action composerChoose(id: string)
    send composerSaved = saveComposer(openAgentId, openDood.workspaceId, id, composerSettings.thinking)
  action composerThink(level: string)
    send composerSaved = saveComposer(openAgentId, openDood.workspaceId, composerSettings.model, level)
  action composerPick(files: Picked[])
    if files.length > 0
      send composerUploaded = uploadComposer(session.owner, openAgentId, openChatId, composerKey, files.map(f => f.path), files.map(f => f.name), files.map(f => f.type), now)
  action composerDrop(e: DragEvent)
    if e.files.length > 0
      preventDefault()
      send composerUploaded = uploadComposer(session.owner, openAgentId, openChatId, composerKey, e.files, e.files.map(f => ""), e.files.map(f => ""), now)
  action composerPaste(e: ClipboardEvent)
    if e.files.length > 0
      if e.text == ""
        preventDefault()
      send composerUploaded = uploadComposer(session.owner, openAgentId, openChatId, composerKey, e.files, e.files.map(f => ""), e.files.map(f => ""), now)
  action composerAfterUpload
    match composerUploaded
      case some(r)
        if r.owner == session.owner and r.key == composerKey
          composerFiles = composerAttachments.concat(r.files)
          composerFilesKey = composerKey
          composerUploadError = r.error
      case none
        composerUploadError = "Could not attach the file."
    focus("composer")
  action composerRemove(id: string)
    composerFiles = composerAttachments.filter(f => f.id != id)
  action composerKeys(key: string, e: KeyboardEvent)
    if key == "Enter" and not e.shiftKey and not e.isComposing
      preventDefault()
      say()
  action composerStop
    if ours and not pending(composerStopped)
      send composerStopped = stopComposer(openAgentId, openChatId)
  action say
    if (draft.trim() != "" or composerAttachments.length > 0) and ours and not pending(said) and not pending(composerUploaded) and not threadsReadOnly
      composerSentKey = composerKey
      composerSentText = draft
      composerSentFiles = composerAttachments.map(f => f.id)
      send said = sendComposer(openAgentId, openChatId, draft.trim(), composerAttachments, composerSettings.sees, `x-${lastId}-${time.epochAtZero + performanceNow()}`)
    focus("composer")
  action afterSay
    if match said { case some(r) => r.ok, case none => false }
      composerRestAt = composerRestAt + 1
      composerDrafts = composerDrafts.filter(d => d.key != composerSentKey or d.text != composerSentText)
      if composerSentKey == composerFilesKey
        composerFiles = composerFiles.filter(f => not composerSentFiles.includes(f.id))
    toEnd()
  action composerVoiceEvent(message: string)
    if message == "cancelled"
      composerVoiceTicket = composerVoiceTicket + 1
    else if message.startsWith("{")
      send composerTranscribed = transcribeComposer(composerKey, composerVoiceTicket, message)
  action composerAfterVoice
    composerVoiceDone = composerVoiceDone + 1
    match composerTranscribed
      case some(r)
        if r.key == composerKey and r.ticket == composerVoiceTicket and r.error == "" and r.text != ""
          let text = draft.trim() == "" ? r.text : `${draft.trim()} ${r.text}`
          editDraft(text)
          if r.end == "send" and not pending(said) and not pending(composerUploaded) and ours
            composerSentKey = composerKey
            composerSentText = text
            composerSentFiles = composerAttachments.map(f => f.id)
            send said = sendComposer(openAgentId, openChatId, text, composerAttachments, composerSettings.sees, `x-voice-${lastId}-${time.epochAtZero + performanceNow()}`)
      case none
        composerUploadError = "Dictation failed."

component ComposerBox
  props
    agentId: string
    chatId: string
    name: string
    draft: string
    ours: bool
    sending: bool
    busy: bool
    editDraft: action
    say: action
  inject
    composerSettings: ComposerConfig
    composerModelsLoading: bool
    composerModelsFailed: bool
    composerRetryModels: action
    composerSaving: bool
    composerAttachments: ComposerFile[]
    composerUploading: bool
    composerUploadError: string
    composerError: string
    composerStopError: string
    composerVoiceError: string
    composerSearch: string
    composerRestAt: number
    composerPick: action
    composerDrop: action
    composerPaste: action
    composerKeys: action
    composerRemove: action
    composerFind: action
    composerChoose: action
    composerThink: action
    composerStop: action
    composerVoiceBusy: bool
    composerVoiceDone: number
    composerVoiceEvent: action
    threadsListing: ThreadListing
    threadsReadOnly: bool
    threadsLoading: bool
    threadsFailed: bool
    threadsRefresh: action
  state entered = false
  state enteredAt = 0
  // The attached picture open large, by its attachment's id; the arrows step through the others.
  state large = ""
  derive pictures = composerAttachments.filter(f => f.preview != "")
  derive largeAt = pictures.map(f => f.id).indexOf(large)
  derive largePicture = match pictures.at(largeAt < 0 ? 0 : largeAt) { case some(f) => f.preview, case none => "" }
  derive largeName = match pictures.at(largeAt < 0 ? 0 : largeAt) { case some(f) => f.name, case none => "" }
  state voice = "idle"
  state voiceCommand = ""
  state voiceSerial = 0
  state modelCursor = 0
  derive expanded = (entered and enteredAt == composerRestAt) or draft != "" or composerAttachments.length > 0 or composerUploading
  derive ready = (draft.trim() != "" or composerAttachments.length > 0) and not composerUploading and not sending and ours
  action modelQuery(text: string)
    modelCursor = 0
    composerFind(text)
  action modelKeys(key: string)
    if key == "ArrowDown"
      preventDefault()
      modelCursor = min(modelCursor + 1, max(0, composerSettings.models.length - 1))
    else if key == "ArrowUp"
      preventDefault()
      modelCursor = max(0, modelCursor - 1)
    else if key == "Enter"
      preventDefault()
      match composerSettings.models.at(modelCursor)
        case some(m)
          composerChoose(m.id)
        case none
          modelCursor = 0
    else if key == "Escape"
      hidePopover("composer-models")
      focus("composer")
  action enter
    entered = true
    enteredAt = composerRestAt
  action leave
    if draft == ""
      entered = false
  action pick
    showPicker("composer-picker")
  action attachOrCancel
    if voice == "idle"
      pick()
    else
      voiceDo("cancel")
  action openPicture(id: string)
    large = id
    showModal("composer-picture")
  action stepPicture(by: number)
    if pictures.length > 0
      large = match pictures.at((largeAt + by + pictures.length) % pictures.length) { case some(f) => f.id, case none => large }
  action pictureKey(k: string)
    if k == "ArrowLeft"
      stepPicture(-1)
    else if k == "ArrowRight"
      stepPicture(1)
  action voiceMessage(message: string)
    if message.startsWith("state:")
      voice = message.slice(6)
    else
      composerVoiceEvent(message)
  action voiceDo(command: string)
    voiceCommand = command
    voiceSerial = voiceSerial + 1
  view
    column max-width="45rem" width="100%" margin="0 auto" padding="4px 16px 16px" box-sizing="border-box" flex-shrink=0 gap=8
      RunningCommands()
      ThreadsMenu(agentId=agentId, chatId=chatId, listing=threadsListing, loading=threadsLoading, failed=threadsFailed, retry=threadsRefresh)
      // A chat read here and written in elsewhere has its foot in this place (views/chat.contract).
      if not threadsReadOnly
        column gap=6 drop=composerDrop testId="composer-drop"
          if composerAttachments.length > 0 or composerUploading
            row flex-wrap="wrap" gap=6 align-items="flex-end" padding="0 8px" aria-label="Attached files" testId="attached-files"
              for f in composerAttachments key=f.id
                if f.preview != ""
                  column position="relative" padding=4 border-radius=10 background-color="surface" width=104 height=72 box-sizing="border-box"
                    button press=openPicture(f.id) aria-label=`Open ${f.name} large` class=IconButton testId=`preview-${f.id}`
                      image f.preview width=96 height=64 object-fit="cover" border-radius=8 alt=f.name
                    button press=composerRemove(f.id) aria-label=`Remove ${f.name}` class=IconButton position="absolute" top=6 right=6
                      width=20 height=20 min-width=20 min-height=20 border-radius=999 background-color="ink" color="canvas" testId=`remove-${f.id}`
                      image "symbol:icon.x" width=12 height=12
                else
                  row gap=4 align-items="center" padding="2px 4px 2px 10px" border-radius=8 background-color="surface" max-width="12rem"
                    text f.name font-size="0.75rem" overflow="hidden" text-overflow="ellipsis" white-space="nowrap" min-width=0 flex=1
                    button press=composerRemove(f.id) aria-label=`Remove ${f.name}` class=IconButton min-width=20 min-height=20 width=20 height=20 testId=`remove-${f.id}`
                      image "symbol:icon.x" width=12 height=12
              if composerUploading
                row gap=6 align-items="center" testId="attaching"
                  progress width=14 height=14 aria-label="Attaching"
                  text "Attaching…" font-size="0.75rem" color="ink.muted"
            if not composerSettings.sees and composerAttachments.filter(f => f.preview != "").length > 0
              text `${name}’s model cannot look at pictures, so it gets these as files. Pick a model that can on its page.` font-size="0.75rem" color="ink.muted" padding="0 12px" testId="pictures-note"
          column class=Composer gap=0 align-items="stretch"
            input id="composer-picker" type="file" multiple=true display="none" change=composerPick aria-label="Choose files to attach" testId="file-picker"
            row display="grid" grid-template-columns="36px minmax(0, 1fr) max-content max-content" gap=4 align-items="end"
              textarea id="composer" value=draft input=editDraft key=composerKeys paste=composerPaste focus=enter blur=leave rows=1 field-sizing="content" max-height=200 box-sizing="border-box"
                display=(voice == "idle" ? "block" : "none") grid-column=(expanded ? "1 / -1" : "2") grid-row="1"
                min-height=(expanded ? 60 : 36) placeholder=`Message ${name}` aria-label="Message" min-width=0 padding="7px 10px"
                border="none" outline="none" background-color="transparent" color="ink" font-family="Geist" font-size="1rem" line-height=1.5 disabled=(not ours) testId="composer"
              button press=attachOrCancel disabled=(not ours) class=IconButton min-width=36 min-height=36
                grid-column="1" grid-row=(expanded or voice != "idle" ? "2" : "1") aria-label=(voice == "idle" ? "Attach a file" : "Cancel dictating") testId="attach"
                image (voice == "idle" ? "symbol:icon.plus" : "symbol:icon.x") width=18 height=18
              if expanded and voice == "idle" and (composerModelsFailed or composerSettings.models.length > 1 or composerSettings.levels.length > 1)
                button popovertarget="composer-models" class=IconButton min-height=36 width=36 grid-column="2" grid-row="2" aria-label="Model and thinking" testId="composer-model-button"
                  image "symbol:icon.brain" width=20 height=20
              do-dictation press=voiceDo("start") role="button" chat-key=`${agentId}:${chatId}` directive=voiceCommand reply=`${composerVoiceDone}` transcribing=`${composerVoiceBusy}` serial=`${voiceSerial}` message=voiceMessage
                grid-column=(voice == "idle" ? "3" : "1 / -1") grid-row=(voice != "idle" or not expanded ? "1" : "2")
                width=(voice == "idle" ? "2.25rem" : "100%") height=(voice == "idle" ? "2.25rem" : "66px") aria-label=(voice == "idle" ? "Dictate" : voice == "recording" ? "Listening" : "Turning what you said into text") testId="dictate"
              if voice == "idle"
                if busy and not ready and not composerUploading
                  button press=composerStop aria-label="Stop" class=SendButton grid-column="4" grid-row=(expanded ? "2" : "1") testId="stop"
                    image "symbol:icon.stop" width=18 height=18
                else
                  CallSend(ready=ready, idle=(draft.trim() == "" and composerAttachments.length == 0 and not composerUploading and not sending and ours), name=name, say=say, expanded=expanded)
              else
                text (voice == "recording" ? "Listening" : "Turning what you said into text") font-size="0.75rem" color="ink.muted" grid-column="2" grid-row="2" role="status"
                button press=voiceDo("draft") disabled=(voice != "recording") class=IconButton grid-column="3" grid-row="2" aria-label="Stop dictating" testId="dictation-draft"
                  text "Stop" font-size="0.75rem"
                button press=voiceDo("send") disabled=(voice != "recording") class=SendButton grid-column="4" grid-row="2" aria-label="Send what you said" testId="dictation-send"
                  image "symbol:icon.arrow-up"
          if composerUploadError != ""
            text composerUploadError color="danger" font-size="0.75rem" role="alert" padding="0 12px" testId="attach-error"
          if composerVoiceError != ""
            text composerVoiceError color="danger" font-size="0.75rem" role="alert" testId="dictation-error"
          if composerStopError != ""
            text composerStopError color="danger" font-size="0.75rem" role="alert" testId="stop-error"
      column id="composer-models" popover="auto" class=Menu width="20rem" max-width="90vw" gap=4
        input value=composerSearch input=modelQuery key=modelKeys placeholder=`Search models` aria-label="Search models" class=Field testId="composer-model-search"
        if composerModelsLoading
          progress aria-label="Loading models" testId="composer-model-loading"
        if composerModelsFailed
          text "Could not load the models." color="danger" font-size="0.75rem" testId="composer-model-load-error"
          button press=composerRetryModels class=MenuItem testId="composer-model-retry"
            text "Try Again"
        scroll max-height=224
          for m, i in composerSettings.models key=m.id
            column
              if i == 0 or match composerSettings.models.at(i - 1) { case some(prev) => prev.source != m.source, case none => true }
                text m.source color="ink.muted" font-size="0.75rem" padding="6px 10px"
              button press=composerChoose(m.id) disabled=composerSaving class=MenuItem text-align="left" background-color=(i == modelCursor ? "wash" : "transparent") aria-pressed=(m.id == composerSettings.model) testId=`composer-model-${m.id}`
                column gap=2 min-width=0
                  text `${m.name}${m.suggested ? " · suggested" : ""}` font-size="0.8125rem" font-weight=(m.id == composerSettings.model ? 600 : 400)
                  text m.facts color="ink.muted" font-size="0.6875rem"
        if composerSettings.models.length == 0
          text "No model matches." color="ink.muted" font-size="0.8125rem" padding=10 testId="composer-no-models"
        if composerSettings.more > 0
          text `${composerSettings.more} more. Type to narrow them down.` font-size="0.75rem" color="ink.muted"
        hr
        text "Thinking" font-size="0.8125rem" font-weight=500 padding="4px 8px"
        row flex-wrap="wrap" gap=4 padding="0 8px"
          for level in composerSettings.levels key=level
            button press=composerThink(level) disabled=composerSaving aria-pressed=(level == composerSettings.thinking) class=MenuItem background-color=(level == composerSettings.thinking ? "wash" : "transparent") testId=`thinking-${level}`
              text (level == "xhigh" ? "Extra high" : level.slice(0, 1).toUpperCase() + level.slice(1)) font-size="0.75rem"
        text (composerSettings.levels.length == 0 ? "This model does not think before it answers." : composerSettings.levels.length == 1 ? "This model always thinks this much." : "How long it thinks before it answers. More is slower and costs more. Applies from its next reply.") font-size="0.75rem" color="ink.muted" padding=8
        if composerError != ""
          text composerError color="danger" font-size="0.75rem" role="alert" testId="composer-model-error"
      dialog id="composer-picture" key=pictureKey max-width="90vw" max-height="90vh" padding=12 border="none" border-radius=12 background-color="popover" color="ink" aria-label="Attached picture"
        column gap=8
          row gap=8 align-items="center"
            text largeName flex=1 min-width=0 font-size="0.875rem" overflow="hidden" text-overflow="ellipsis" white-space="nowrap" testId="picture-name"
            if pictures.length > 1
              text `${largeAt + 1} of ${pictures.length}` font-size="0.8125rem" color="ink.muted" testId="picture-count"
              button press=stepPicture(-1) aria-label="Previous picture" class=IconButton testId="picture-previous"
                image "symbol:icon.caret-left" font-size="1rem"
              button press=stepPicture(1) aria-label="Next picture" class=IconButton testId="picture-next"
                image "symbol:icon.caret-right" font-size="1rem"
            button command="close" commandfor="composer-picture" aria-label="Close" class=IconButton testId="picture-close"
              image "symbol:icon.x" font-size="1rem"
          image largePicture max-width="80vw" max-height="75vh" object-fit="contain" alt=largeName
