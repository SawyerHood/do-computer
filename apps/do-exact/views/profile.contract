// A Dood's profile page: a PLACEHOLDER until its area is built. It will hold its name, its creature's colour and seed, its memory, its model and thinking.
// The React app's is apps/web/src/components/settings/profile.tsx. To build it: give this file a `members App` block for its
// resources, mutations and actions (listed in app.contract beside the others), and its data
// sources in data/profile.ts (gathered in app.ts); then pass what the screen reads as props where
// app.contract draws it. Keep the DoodScreen frame: it is the header, the title and the lead.
use Page from "./shapes.contract"
use DoodScreen from "./shell.contract"

component ProfileScreen
  props
    page: Page
  view
    DoodScreen(page=page, route="profile", lead="Who your Dood is: its name, its look, and what it remembers.")
      text "Not in this app yet." font-size="0.875rem" color="ink.muted" testId="placeholder-profile"
