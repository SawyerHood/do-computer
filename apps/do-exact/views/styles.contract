// Do Computer's look, shared: the type, the sidebar's rows, the pill over a Dood's pages, the
// chat's bubbles and composer. Colours are app.tamber's tokens; sizes are the React app's
// (Tailwind's rem steps, apps/web/src/styles.css and the shell's classes).

// The page under a screen, and the sidebar's frame.
style Screen
  background-color="canvas" color="ink" font-family="Geist"

style Frame
  background-color="frame" color="ink" font-family="Geist"

// The small grey heading over a list ("Doods", a workspace's name).
style ListHeading
  font-size="0.8125rem" font-weight=500 color="ink.muted"

// A row in the sidebar: a Dood, or an entry under the list. A chosen one is washed.
style SidebarRow
  display="flex" align-items="center" gap=12 padding="8px 8px" border-radius="0.7rem"
  text-decoration="none" color="ink"
  :hover
    background-color="wash"
  :checked
    background-color="wash"

style RowName
  font-size="0.90625rem" font-weight=500 color="ink"

style RowLine
  font-size="0.75rem" color="ink.muted"

style RowTime
  font-size="0.71875rem" color="ink.muted"

// A small round button with a symbol: the sidebar's + and …, the composer's.
style IconButton
  width=28 height=28 border-radius=8 display="flex" align-items="center" justify-content="center"
  color="ink.muted" background-color="transparent" border="none" padding=0
  :hover
    background-color="wash"

// The pill at the top of a Dood's pages: its face, its name and the way to its other pages.
style Pill
  display="flex" align-items="center" gap=2 padding=2 border-radius=999
  background-color="popover" box-shadow="0 0 0 1px var(--hairline), 0 1px 2px rgb(0 0 0 / 0.07)"

style PillButton
  display="flex" align-items="center" gap=6 height=32 padding="0 10px 0 6px" border-radius=999
  background-color="transparent" border="none" color="ink"
  :hover
    background-color="wash"

// A menu that drops from a button (the pill's, a row's, the account's).
style Menu
  min-width=224 padding=4 border-radius=12 background-color="popover" color="ink" font-family="Geist"
  box-shadow="0 0 0 1px var(--hairline), 0 2px 5px rgb(0 0 0 / 0.05), 0 22px 48px -22px rgb(0 0 0 / 0.26)"

style MenuItem
  display="flex" align-items="center" gap=8 padding="6px 10px" border-radius=8 font-size="0.875rem"
  color="ink" background-color="transparent" border="none" text-decoration="none"
  :hover
    background-color="wash"

// A screen's title and the words under it, on a page that is not the chat.
style PageTitle
  font-size="1.25rem" font-weight=600 letter-spacing="-0.01em" color="ink"

style PageLead
  font-size="0.875rem" color="ink.muted"

// What a person said: ink at 11% over the page, round, on the right.
style UserBubble
  padding="8px 16px" border-radius=18 background-color="bubble" color="ink"
  font-size="1rem" line-height=1.55

// The composer: a raised field with round ends, the send button inside it.
style Composer
  display="flex" align-items="flex-end" gap=4 padding=6 border-radius=24
  background-color="popover"
  box-shadow="0 0 0 1px var(--hairline), 0 1px 2px rgb(0 0 0 / 0.07)"

style SendButton
  width=36 height=36 border-radius=18 display="flex" align-items="center" justify-content="center"
  background-color="primary" color="primary.ink" border="none" padding=0
  :disabled
    background-color="muted"
    color="ink.muted"

// A filled button in the app's colour: the main action on a page.
style PrimaryButton
  height=34 padding="0 14px" border-radius=8 font-size="0.875rem" font-weight=500
  background-color="primary" color="primary.ink" border="none"
  :disabled
    opacity=0.5

// A field in a form (sign-in): the React app's input, bordered and rounded.
style Field
  height=36 padding="0 10px" border-radius=8 border="1px solid var(--input)" font-size="0.875rem"
  background-color="transparent" color="ink" font-family="Geist"

style FieldLabel
  font-size="0.875rem" font-weight=500 color="ink"
