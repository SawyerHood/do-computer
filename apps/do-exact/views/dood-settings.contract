// A Dood's settings page: a PLACEHOLDER until its area is built. It will hold its model, its thinking, its notifications, moving it to another workspace.
// The React app's is apps/web/src/components/settings/general.tsx. To build it: give this file a `members App` block for its
// resources, mutations and actions (listed in app.contract beside the others), and its data
// sources in data/dood-settings.ts (gathered in app.ts); then pass what the screen reads as props where
// app.contract draws it. Keep the DoodScreen frame: it is the header, the title and the lead.
use Page from "./shapes.contract"
use DoodScreen from "./shell.contract"

component DoodSettingsScreen
  props
    page: Page
  view
    DoodScreen(page=page, route="settings", lead="How your Dood works, and where it lives.")
      text "Not in this app yet." font-size="0.875rem" color="ink.muted" testId="placeholder-settings"
