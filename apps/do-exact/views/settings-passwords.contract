// A workspace's Passwords (`/w/:workspaceId/passwords`), as the React app's PasswordsSettings
// (apps/web/src/components/settings/passwords.tsx and cards.tsx): the logins its Doods can sign
// in with and the cards they can pay with, whichever of them it keeps. Nothing shows a password
// or a card's number again: a login can be added, given a new password, changed or removed, and
// a card added or removed. What is typed for one is in states that are never kept, sent as a
// mutation's arguments, and emptied when the window closes. data/settings-passwords.ts answers it.
use Session, Reply, Page, Workspace from "./shapes.contract"
use Menu, MenuItem, PrimaryButton, IconButton from "./styles.contract"
use WorkspaceSettingsFrame, SettingsList, SettingsEmpty, Confirm, ErrorLine from "./settings-kit.contract"
use SettingsField, FieldName, Hint, SmallHint, OutlineButton, GhostButton from "./settings-kit.contract"
use WorkspacesAbout, workspaceAboutOf from "./settings-account.contract"

shape LoginView
  id: string
  name: string
  username: string
  sites: string[]
  // When it was last used, 0 for never, and by which Dood.
  usedAt: number
  usedBy: string
  // Its password can no longer be read, as after the deployment's key changed.
  unreadable: bool

shape SavedLogins
  owner: string
  workspaceId: string
  // The workspace keeps logins and this person may see them.
  kept: bool
  logins: LoginView[]

shape CardView
  id: string
  name: string
  // Its kind, the end of its number, when it expires and the name on it, in a line.
  words: string
  // What only removing it and adding it again puts right, "" for nothing.
  trouble: string
  usedAt: number
  usedBy: string

shape SavedCards
  owner: string
  workspaceId: string
  kept: bool
  cards: CardView[]

shape SiteAdded
  ok: bool
  error: string
  sites: string[]

// How long ago, as the protocol's `usedWords` says it (Intl's "numeric: auto").
fn agoWords(n: number, unit: string): string = n == 1 ? (unit == "day" ? "yesterday" : unit == "week" ? "last week" : unit == "month" ? "last month" : unit == "year" ? "last year" : `1 ${unit} ago`) : `${n} ${unit}s ago`
fn usedWords(usedAt: number, usedBy: string, now: number): string = usedAt == 0 ? "Not used yet" : `Used ${whenWords(round((now - usedAt) / 60000))}${usedBy == "" ? "" : ` by ${usedBy}`}`
fn whenWords(minutes: number): string = minutes < 1 ? "just now" : minutes < 60 ? agoWords(minutes, "minute") : round(minutes / 60) < 24 ? agoWords(round(minutes / 60), "hour") : round(minutes / 1440) < 7 ? agoWords(round(minutes / 1440), "day") : round(minutes / 1440) < 30 ? agoWords(round(minutes / 10080), "week") : round(minutes / 1440) < 365 ? agoWords(round(minutes / 43200), "month") : agoWords(round(minutes / 525600), "year")
// A card number in groups of four, as it is typed.
fn grouped(typed: string): string = [0, 4, 8, 12, 16].map(i => typed.replaceAll(" ", "").slice(i, i + 4)).filter(s => s != "").join(" ")

members App
  // --- settings: passwords ---
  derive passwordsWorkspaceId = onRoute == "passwords" ? settingsWorkspaceId : ""
  derive monthKey = formatDate(now, time.utcOffset, "iso").slice(0, 7)
  resource savedLogins = loadSavedLogins(session.owner, passwordsWorkspaceId, passwordsWorkspaceId != "") as shape SavedLogins else empty()
  resource savedCards = loadSavedCards(session.owner, passwordsWorkspaceId, passwordsWorkspaceId != "") with monthKey as shape SavedCards else empty()

  // The login window: "" shut, "add", "password" (a new one) or "change" (all but the password).
  state loginEditing = ""
  state loginEditId = ""
  state loginEditName = ""
  state lName = ""
  state lUsername = ""
  state lPassword = ""
  state lShowPassword = false
  state lSites = []
  state lSite = ""
  state lProblem = ""
  mutation loginSaved as shape Reply refreshes savedLogins then afterLoginSave
  mutation siteAdded as shape SiteAdded then afterSiteAdd
  derive loginError = lProblem != "" ? lProblem : pending(loginSaved) ? "" : match loginSaved { case some(r) => r.error, case none => "" }
  state loginAim = ""
  state loginAimName = ""
  mutation loginRemoved as shape Reply refreshes savedLogins
  derive loginRemoveError = pending(loginRemoved) ? "" : match loginRemoved { case some(r) => r.error, case none => "" }

  // The card window, and what is typed in it.
  state cNumber = ""
  state cExpires = ""
  state cHolder = ""
  state cPostal = ""
  state cName = ""
  mutation cardSaved as shape Reply refreshes savedCards then afterCardSave
  derive cardError = pending(cardSaved) ? "" : match cardSaved { case some(r) => r.error, case none => "" }
  state cardAim = ""
  state cardAimName = ""
  mutation cardRemoved as shape Reply refreshes savedCards
  derive cardRemoveError = pending(cardRemoved) ? "" : match cardRemoved { case some(r) => r.error, case none => "" }

  action openLogin(what: string, id: string, name: string, username: string, sites: string[])
    loginEditing = what
    loginEditId = id
    loginEditName = name
    lName = name
    lUsername = username
    lPassword = ""
    lShowPassword = false
    lSites = sites
    lSite = ""
    lProblem = ""
    showModal("login-window")
  action editLoginField(field: string, v: string)
    lProblem = ""
    lName = field == "name" ? v : lName
    lUsername = field == "username" ? v : lUsername
    lPassword = field == "password" ? v : lPassword
    lSite = field == "site" ? v : lSite
  action toggleShowPassword
    lShowPassword = not lShowPassword
  action addSiteNow
    if lSite.trim() != ""
      send siteAdded = addSite(lSites, lSite)
  action afterSiteAdd
    match siteAdded
      case some(r)
        if r.ok
          lSites = r.sites
          lSite = ""
          lProblem = ""
        else
          lProblem = r.error
      case none
        lSite = lSite
  action removeSite(site: string)
    lSites = lSites.filter(x => x != site)
  action saveLoginNow
    if not pending(loginSaved)
      lProblem = ""
      if loginEditing == "add"
        send loginSaved = saveLogin(passwordsWorkspaceId, lName, lUsername, lPassword, lSites, lSite)
      else
        send loginSaved = changeLogin(passwordsWorkspaceId, loginEditId, loginEditing, lName, lUsername, lPassword, lSites, lSite)
  action afterLoginSave
    match loginSaved
      case some(r)
        if r.ok
          closeLogin()
      case none
        lPassword = lPassword
  // Leaves without saving, and with nothing of a password that was typed.
  action closeLogin
    lPassword = ""
    lShowPassword = false
    loginEditing = ""
    close("login-window")
  action askRemoveLogin(id: string, name: string)
    loginAim = id
    loginAimName = name
    showModal("login-remove")
  action removeLoginNow
    send loginRemoved = removeLogin(passwordsWorkspaceId, loginAim)

  action openCard
    cNumber = ""
    cExpires = ""
    cHolder = ""
    cPostal = ""
    cName = ""
    showModal("card-window")
  action editCardField(field: string, v: string)
    cNumber = field == "number" ? grouped(v) : cNumber
    cExpires = field == "expires" ? v : cExpires
    cHolder = field == "holder" ? v : cHolder
    cPostal = field == "postal" ? v : cPostal
    cName = field == "name" ? v : cName
  action saveCardNow
    if not pending(cardSaved)
      send cardSaved = saveCard(passwordsWorkspaceId, cNumber, cExpires, cHolder, cPostal, cName, monthKey)
  action afterCardSave
    match cardSaved
      case some(r)
        if r.ok
          closeCard()
      case none
        cNumber = cNumber
  // Leaves with nothing of the card that was typed.
  action closeCard
    cNumber = ""
    cExpires = ""
    cHolder = ""
    cPostal = ""
    cName = ""
    close("card-window")
  action askRemoveCard(id: string, name: string)
    cardAim = id
    cardAimName = name
    showModal("card-remove")
  action removeCardNow
    send cardRemoved = removeCard(passwordsWorkspaceId, cardAim)

component PasswordsScreen
  props
    page: Page
  inject
    session: Session
    workspacesAbout: WorkspacesAbout
    savedLogins: SavedLogins
    savedCards: SavedCards
  derive about = workspaceAboutOf(workspacesAbout.workspaces, page.workspaceId)
  derive known = workspacesAbout.owner == session.owner
  view
    WorkspaceSettingsFrame(page=page, route="passwords", title="Passwords", lead="", listing=false)
      if not known
        progress aria-label="Loading"
      else if not about.secrets
        text "This workspace keeps no logins or cards that you can see." class=Hint margin-top=-20 testId="passwords-none"
      else
        column gap=40
          if about.logins
            Logins(workspaceId=page.workspaceId)
          if about.cards
            Cards(workspaceId=page.workspaceId)
      LoginWindow()
      CardWindow()

// The logins a workspace keeps for its Doods to sign in to websites with.
component Logins
  props
    workspaceId: string
  inject
    session: Session
    now: number
    savedLogins: SavedLogins
    loginRemoving: bool
    loginRemoveError: string
    loginAimName: string
    openLogin: action
    askRemoveLogin: action
    removeLoginNow: action
  derive ours = savedLogins.owner == session.owner and savedLogins.workspaceId == workspaceId
  view
    column gap=24 margin-top=-20 testId="logins"
      row flex-wrap="wrap" align-items="flex-end" justify-content="space-between" gap=12
        text "Logins the Doods of this workspace can sign in with. A Dood uses one without seeing it, and only on the sites it is for." flex="1 1 16rem" min-width=0 class=Hint
        button press=openLogin("add", "", "", "", []) class=PrimaryButton display="flex" align-items="center" gap=6 min-height="2rem" testId="login-add"
          image "symbol:icon.plus" aria-hidden=true
          text "Add a login"
      if not ours
        progress aria-label="Loading"
      else if savedLogins.logins.length == 0
        SettingsEmpty(title="No logins yet", message="Add one here, or wait for a Dood to ask: when a site wants it to sign in and it has no login for it, it asks you for one in the chat.", testId="logins-empty")
          button press=openLogin("add", "", "", "", []) class=OutlineButton testId="login-add-first"
            image "symbol:icon.plus" aria-hidden=true
            text "Add a login"
      else
        SettingsList(label="Saved logins", testId="logins-list")
          for l, i in savedLogins.logins key=l.id
            row role="listitem" flex-wrap="wrap" align-items="center" gap=12 padding=14 border-top=(i == 0 ? "none" : "1px solid var(--border)") testId=`login-${i}`
              column width="2rem" height="2rem" border-radius=8 background-color="secondary" align-items="center" justify-content="center" flex-shrink=0 aria-hidden=true
                text l.name.trim().slice(0, 1).toUpperCase() font-size="0.875rem" font-weight=600 color="ink.muted"
              column flex="1 1 10rem" min-width=0
                text l.name font-weight=500 overflow="hidden" text-overflow="ellipsis" white-space="nowrap" testId=`login-name-${i}`
                text `${l.username} · ${l.sites.join(", ")}` font-size="0.75rem" color="ink.muted" testId=`login-about-${i}`
                if l.unreadable
                  text "Its password can no longer be read: give it again" font-size="0.75rem" color="danger"
                else
                  text usedWords(l.usedAt, l.usedBy, now) font-size="0.75rem" color="ink.muted"
              if l.unreadable
                button press=openLogin("password", l.id, l.name, l.username, l.sites) disabled=loginRemoving class=OutlineButton
                  text "Replace the password"
              button popovertarget=`login-menu-${l.id}` disabled=loginRemoving aria-label=`Change or remove ${l.name}` class=IconButton testId=`login-menu-${i}`
                image "symbol:icon.dots" font-size="1rem"
              column id=`login-menu-${l.id}` popover="auto" role="menu" aria-label=l.name class=Menu
                button role="menuitem" press=openLogin("password", l.id, l.name, l.username, l.sites) popovertarget=`login-menu-${l.id}` popovertargetaction="hide" class=MenuItem testId=`login-password-${i}`
                  text "Replace the password"
                button role="menuitem" press=openLogin("change", l.id, l.name, l.username, l.sites) popovertarget=`login-menu-${l.id}` popovertargetaction="hide" class=MenuItem testId=`login-change-${i}`
                  text "Change its name or sites"
                button role="menuitem" press=askRemoveLogin(l.id, l.name) popovertarget=`login-menu-${l.id}` popovertargetaction="hide" class=MenuItem color="danger" testId=`login-remove-${i}`
                  text "Remove"
        ErrorLine(text=loginRemoveError, testId="login-remove-error")
      row align-items="flex-start" gap=8
        image "symbol:icon.lock" aria-hidden=true color="ink.muted" font-size="0.875rem" margin-top=2
        text "Kept encrypted by Do Computer. A password can be replaced or removed here, and never shown again, to you or to a Dood. Whether a Dood asks before using one is set under its Permissions." class=SmallHint
      Confirm(id="login-remove", title=`Remove ${loginAimName}?`, message="Its password is deleted, and no Dood of this workspace can sign in with it any more.", action="Remove", destructive=true, confirm=removeLoginNow, testId="login-remove-confirm")

// The window a login is typed in. Adding one asks for all of it; a new password asks for that
// alone; changing it asks for everything but the password, which is never shown.
component LoginWindow
  inject
    loginEditing: string
    loginEditName: string
    lName: string
    lUsername: string
    lPassword: string
    lShowPassword: bool
    lSites: string[]
    lSite: string
    loginError: string
    loginSaving: bool
    editLoginField: action
    toggleShowPassword: action
    addSiteNow: action
    removeSite: action
    saveLoginNow: action
    closeLogin: action
  derive title = loginEditing == "add" ? "Add a login" : loginEditing == "password" ? `Replace the password of ${loginEditName}` : `Change ${loginEditName}`
  derive description = loginEditing == "add" ? "A Dood of this workspace can sign in with it on the sites you name. It is never shown the password, and neither is anyone else once it is saved." : loginEditing == "password" ? `The one kept for ${lUsername} is replaced by what you type. It is not shown again.` : "Its password stays as it is."
  view
    dialog id="login-window" aria-label=title closedby="none" width="min(28rem, calc(100vw - 32px))" padding=24 border-radius=16 background-color="popover" color="ink" testId="login-window"
      column gap=16
        column gap=4
          text title role="heading" aria-level=2 font-size="1.125rem" font-weight=600 testId="login-window-title"
          text description class=Hint
        if loginEditing != "password"
          column gap=6
            text "Name" class=FieldName
            input value=lName input=editLoginField("name") placeholder="GitHub" autocomplete="off" maxlength=60 disabled=loginSaving aria-label="Name" class=SettingsField testId="login-name"
          column gap=6
            text "Username or email" class=FieldName
            input value=lUsername input=editLoginField("username") autocomplete="off" disabled=loginSaving aria-label="Username or email" class=SettingsField testId="login-username"
        if loginEditing != "change"
          column gap=6
            text (loginEditing == "password" ? "New password" : "Password") class=FieldName
            row gap=4 align-items="center"
              input type=(lShowPassword ? "text" : "password") value=lPassword input=editLoginField("password") autocomplete="new-password" disabled=loginSaving
                aria-label=(loginEditing == "password" ? "New password" : "Password") class=SettingsField flex=1 testId="login-password"
              button press=toggleShowPassword aria-label=(lShowPassword ? "Hide the password" : "Show the password") aria-pressed=lShowPassword class=IconButton min-width="2.25rem" min-height="2.25rem" testId="login-password-show"
                image (lShowPassword ? "symbol:icon.eye-slash" : "symbol:icon.eye") font-size="1rem"
        if loginEditing != "password"
          column gap=6
            text "Used only on" class=FieldName
            row role="list" aria-label="Used only on" flex-wrap="wrap" align-items="center" gap=6
              for site in lSites key=site
                row role="listitem" align-items="center" gap=2 min-height="1.75rem" padding="0 4px 0 10px" border-radius=999 background-color="wash" font-family="Geist Mono" font-size="0.8125rem"
                  text site
                  button press=removeSite(site) disabled=loginSaving aria-label=`Remove ${site}` class=IconButton min-width="1.25rem" min-height="1.25rem" border-radius=999 testId=`login-site-remove-${site}`
                    image "symbol:icon.x" font-size="0.75rem"
              input value=lSite input=editLoginField("site") submit=addSiteNow placeholder="github.com" autocomplete="off" disabled=loginSaving aria-label="A site to add"
                class=SettingsField flex="1 1 8rem" font-family="Geist Mono" testId="login-site"
            text "It is typed on these sites and the ones under them, such as app.example.com for example.com, and nowhere else." class=SmallHint
        ErrorLine(text=loginError, testId="login-error")
        row justify-content="flex-end" gap=8
          button press=closeLogin disabled=loginSaving class=OutlineButton testId="login-cancel"
            text "Cancel"
          button press=saveLoginNow disabled=loginSaving class=PrimaryButton testId="login-save"
            text (loginSaving ? "Saving…" : "Save")

// The cards a workspace keeps for its Doods to pay with on websites (cards.tsx).
component Cards
  props
    workspaceId: string
  inject
    session: Session
    savedCards: SavedCards
    cardRemoving: bool
    cardRemoveError: string
    cardAimName: string
    openCard: action
    askRemoveCard: action
    removeCardNow: action
  derive ours = savedCards.owner == session.owner and savedCards.workspaceId == workspaceId
  view
    column gap=24 testId="cards"
      row flex-wrap="wrap" align-items="flex-end" justify-content="space-between" gap=12
        column flex="1 1 16rem" min-width=0 gap=2
          text "Cards" role="heading" aria-level=2 font-size="1.125rem" font-weight=600
          text "Cards the Doods of this workspace can pay with on websites. A Dood uses one without seeing its number, and someone is asked every time." class=Hint
        button press=openCard class=PrimaryButton display="flex" align-items="center" gap=6 min-height="2rem" testId="card-add"
          image "symbol:icon.plus" aria-hidden=true
          text "Add a card"
      if not ours
        progress aria-label="Loading"
      else if savedCards.cards.length == 0
        SettingsEmpty(title="No cards yet", message="Add one for the Doods of this workspace to pay with when a website asks for a card.", testId="cards-empty")
          button press=openCard class=OutlineButton testId="card-add-first"
            image "symbol:icon.plus" aria-hidden=true
            text "Add a card"
      else
        SettingsList(label="Saved cards", testId="cards-list")
          for c, i in savedCards.cards key=c.id
            row role="listitem" flex-wrap="wrap" align-items="center" gap=12 padding=14 border-top=(i == 0 ? "none" : "1px solid var(--border)") testId=`card-${i}`
              column width="2rem" height="2rem" border-radius=8 background-color="secondary" align-items="center" justify-content="center" flex-shrink=0 aria-hidden=true
                image "symbol:icon.credit-card" color="ink.muted"
              column flex="1 1 10rem" min-width=0
                text c.name font-weight=500 overflow="hidden" text-overflow="ellipsis" white-space="nowrap" testId=`card-name-${i}`
                text c.words font-size="0.75rem" color="ink.muted"
                if c.trouble != ""
                  text c.trouble font-size="0.75rem" color="danger"
                else
                  text (c.usedAt == 0 ? "Not used yet" : `Used${c.usedBy == "" ? "" : ` by ${c.usedBy}`}`) font-size="0.75rem" color="ink.muted"
              button press=askRemoveCard(c.id, c.name) disabled=cardRemoving aria-label=`Remove ${c.name}` class=GhostButton testId=`card-remove-${i}`
                text "Remove"
        ErrorLine(text=cardRemoveError, testId="card-remove-error")
      row align-items="flex-start" gap=8
        image "symbol:icon.lock" aria-hidden=true color="ink.muted" font-size="0.875rem" margin-top=2
        text "A card’s security code is never kept. Whoever says a card may be used types it then." class=SmallHint
      Confirm(id="card-remove", title=`Remove ${cardAimName}?`, message="Its number is deleted, and no Dood of this workspace can pay with it any more.", action="Remove", destructive=true, confirm=removeCardNow, testId="card-remove-confirm")

// The window a card is typed in. There is no box for its security code, which is never kept.
component CardWindow
  inject
    cNumber: string
    cExpires: string
    cHolder: string
    cPostal: string
    cName: string
    cardError: string
    cardSaving: bool
    editCardField: action
    saveCardNow: action
    closeCard: action
  view
    dialog id="card-window" aria-label="Add a card" closedby="none" width="min(28rem, calc(100vw - 32px))" padding=24 border-radius=16 background-color="popover" color="ink" testId="card-window"
      column gap=16
        column gap=4
          text "Add a card" role="heading" aria-level=2 font-size="1.125rem" font-weight=600
          text "A Dood of this workspace can pay with it on a website, without seeing its number. Someone is asked every time." class=Hint
        column gap=6
          text "Card number" class=FieldName
          input value=cNumber input=editCardField("number") inputmode="numeric" autocomplete="off" disabled=cardSaving aria-label="Card number" class=SettingsField font-family="Geist Mono" testId="card-number"
        row gap=12
          column gap=6 flex=1 min-width=0
            text "Expires" class=FieldName
            input value=cExpires input=editCardField("expires") inputmode="numeric" placeholder="MM / YY" maxlength=9 autocomplete="off" disabled=cardSaving aria-label="Expires" class=SettingsField testId="card-expires"
          column gap=6 flex=1 min-width=0
            text "Postal code (optional)" class=FieldName
            input value=cPostal input=editCardField("postal") autocapitalize="characters" autocomplete="off" disabled=cardSaving aria-label="Postal code (optional)" class=SettingsField testId="card-postal"
        text "There is no box for the security code, since it is never kept. Whoever says the card may be used types it then." class=SmallHint
        column gap=6
          text "Name on the card (optional)" class=FieldName
          input value=cHolder input=editCardField("holder") autocomplete="off" disabled=cardSaving aria-label="Name on the card (optional)" class=SettingsField testId="card-holder"
        column gap=6
          text "Name (optional)" class=FieldName
          input value=cName input=editCardField("name") placeholder="Visa ending 4242" maxlength=60 autocomplete="off" disabled=cardSaving aria-label="Name (optional)" class=SettingsField testId="card-name"
        text "A card made for this with a spending limit is the safer one to save." class=SmallHint
        ErrorLine(text=cardError, testId="card-error")
        row justify-content="flex-end" gap=8
          button press=closeCard disabled=cardSaving class=OutlineButton testId="card-cancel"
            text "Cancel"
          button press=saveCardNow disabled=cardSaving class=PrimaryButton testId="card-save"
            text (cardSaving ? "Saving…" : "Save")
