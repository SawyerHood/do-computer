// A Dood's computers page: a PLACEHOLDER until its area is built. It will hold its computers, pairing one, and answering a Dood that asks for one.
// The React app's is apps/web/src/components/settings/computers.tsx. To build it: give this file a `members App` block for its
// resources, mutations and actions (listed in app.contract beside the others), and its data
// sources in data/computers.ts (gathered in app.ts); then pass what the screen reads as props where
// app.contract draws it. Keep the DoodScreen frame: it is the header, the title and the lead.
use Page from "./shapes.contract"
use DoodScreen from "./shell.contract"

component ComputersScreen
  props
    page: Page
  view
    DoodScreen(page=page, route="computers", lead="The computers your Dood works on, and the ones it asks to use.")
      text "Not in this app yet." font-size="0.875rem" color="ink.muted" testId="placeholder-computers"
