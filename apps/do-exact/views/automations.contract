// A Dood's automations page: a PLACEHOLDER until its area is built. It will hold the schedules, each with its next run and what its runs came to.
// The React app's is apps/web/src/routes/_app.a.$agentId.automations.tsx. To build it: give this file a `members App` block for its
// resources, mutations and actions (listed in app.contract beside the others), and its data
// sources in data/automations.ts (gathered in app.ts); then pass what the screen reads as props where
// app.contract draws it. Keep the DoodScreen frame: it is the header, the title and the lead.
use Page from "./shapes.contract"
use DoodScreen from "./shell.contract"

component AutomationsScreen
  props
    page: Page
  view
    DoodScreen(page=page, route="automations", lead="Things your Dood does on its own, once or on a schedule. To add one, ask in chat: “Every weekday at 9, tell me what is on my calendar.”")
      text "Not in this app yet." font-size="0.875rem" color="ink.muted" testId="placeholder-automations"
