// A Dood's permissions page: a PLACEHOLDER until its area is built. It will hold what it may do unasked, and what it has been told to ask about.
// The React app's is apps/web/src/components/settings/permissions.tsx. To build it: give this file a `members App` block for its
// resources, mutations and actions (listed in app.contract beside the others), and its data
// sources in data/permissions.ts (gathered in app.ts); then pass what the screen reads as props where
// app.contract draws it. Keep the DoodScreen frame: it is the header, the title and the lead.
use Page from "./shapes.contract"
use DoodScreen from "./shell.contract"

component PermissionsScreen
  props
    page: Page
  view
    DoodScreen(page=page, route="permissions", lead="What your Dood may do without asking you first.")
      text "Not in this app yet." font-size="0.875rem" color="ink.muted" testId="placeholder-permissions"
