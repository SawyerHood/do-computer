use Dood from "./shapes.contract"
use DoodFace from "./creature.contract"
use doodOf, ago from "./shell.contract"
use Reply from "./shapes.contract"
use Menu, MenuItem, IconButton from "./styles.contract"

shape ThreadRow
  id: string
  title: string
  kind: string
  main: bool
  status: string
  detail: string
  url: string
  parentId: string
  peerId: string
  updated: number

shape ThreadListing
  owner: string
  agentId: string
  chats: ThreadRow[]

members App
  // --- threads ---
  resource threads = loadThreads(session.owner, onRoute == "dood" or onRoute == "chat" ? openAgentId : "") with `${pulse.changes}:${lastId}:${chat.busy}` as shape ThreadListing else empty()
  derive threadsListing = threads.owner == session.owner and threads.agentId == openAgentId ? threads : ThreadListing(owner="", agentId="", chats=[])
  derive threadsReadOnly = chatEntryId != "" and (opened.owner != session.owner or opened.agentId != openAgentId or chatEntryId != opened.chatId)
  action threadsRefresh
    refresh threads

component ThreadsMenu
  props
    agentId: string
    chatId: string
    listing: ThreadListing
    loading: bool
    failed: bool
    retry: action
  inject
    doodList: Dood[]
    now: number
    utcOffset: number
  derive other = listing.chats.filter(c => not c.main)
  view
    row justify-content="flex-end"
      if other.length > 0 or failed
        button popovertarget="threads-menu" class=IconButton padding="4px 10px" aria-label="Other chats" testId="other-chats"
          text `Other chats${other.length > 0 ? ` · ${other.length}` : ""}` font-size="0.75rem"
      column id="threads-menu" popover="auto" class=Menu max-width="90vw" width="20rem"
        if loading
          progress aria-label="Loading chats" testId="threads-loading"
        if failed
          text "Could not load the chats." color="danger" font-size="0.8125rem" padding=8 testId="threads-error"
          button press=retry class=MenuItem testId="threads-retry"
            text "Try Again"
        for group in ["chat", "agent", "slack", "subagent"] key=group
          if listing.chats.filter(c => c.kind == group and not c.main).length > 0
            text (group == "chat" ? "Old side chats · kept to read" : group == "agent" ? "From other Doods" : group == "slack" ? "From Slack" : "Sub-agents") color="ink.muted" font-size="0.75rem" padding="8px 10px"
            for c in listing.chats.filter(c => c.kind == group and not c.main) key=c.id
              link href=path("chat", agentId, c.id) class=MenuItem aria-label=c.title aria-current=(c.id == chatId ? "page" : "false") testId=`thread-${c.id}`
                if c.kind == "agent"
                  DoodFace(seed=doodOf(doodList, c.peerId).seed, color=doodOf(doodList, c.peerId).color, state="idle", name=c.detail, size=32)
                else
                  image (c.kind == "slack" ? "symbol:hashtag" : c.kind == "subagent" ? "symbol:messages" : "symbol:document") width="1.5rem" height="1.5rem" color="ink.muted"
                column gap=2 min-width=0 flex=1
                  text c.title font-size="0.875rem" overflow-wrap="break-word"
                  text (c.kind == "chat" ? ago(c.updated, now, utcOffset) : c.detail) font-size="0.75rem" color="ink.muted"
                if c.status == "working"
                  progress width=14 height=14 aria-label="Answering"
                else
                  text c.status color=(c.status == "failed" ? "danger" : "ink.muted") font-size="0.6875rem"
        for c in listing.chats.filter(c => c.main) key=c.id
          hr
          link href=path("dood", agentId) class=MenuItem testId="threads-main"
            text "Main chat"

component ThreadFoot
  props
    agentId: string
    chatId: string
    listing: ThreadListing
    busy: bool
    stop: action
  derive selected = match first(listing.chats.filter(c => c.id == chatId)) { case some(c) => c, case none => ThreadRow(id="", title="", kind="", main=false, status="", detail="", url="", parentId="", peerId="", updated=0) }
  view
    column gap=10 padding="8px 12px" color="ink.muted" testId="thread-foot"
      row gap=8 align-items="center" flex-wrap="wrap"
        link href=path("dood", agentId) class=MenuItem testId="main-chat-link"
          text "Main chat"
        text selected.title flex="1 1 12rem" min-width=0 font-size="0.875rem" font-weight=500 testId="thread-title"
        if busy or selected.status == "working" or selected.status == "waiting"
          button press=stop class=MenuItem testId="thread-stop"
            text "Stop"
      if selected.kind == "slack"
        row gap=8 align-items="center" padding=12 border="1px dashed var(--input)" border-radius=16
          text "This conversation is in Slack. Reply there to carry it on." font-size="0.875rem" flex=1
          if selected.url != ""
            link href=selected.url target="_blank" class=MenuItem testId="open-slack"
              text "Open in Slack"
      else if selected.kind == "agent"
        text `A conversation with ${selected.detail}. It is read here, and written by the Doods.` font-size="0.875rem" testId="thread-read-only"
      else if selected.kind == "subagent"
        text "A sub-agent’s conversation, kept here to read." font-size="0.875rem" testId="thread-read-only"
        if selected.parentId != ""
          link href=path("chat", agentId, selected.parentId) class=MenuItem testId="thread-parent"
            text "Back to its parent chat"
      else
        text "An old side chat, kept to read. Everything with your Dood now happens in its main chat." font-size="0.875rem" testId="thread-read-only"
