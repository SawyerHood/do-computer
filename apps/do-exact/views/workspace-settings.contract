// The workspace's section list. On a phone its sections open over this list, as the Dood's do.
use Page from "./shapes.contract"
use WorkspaceSettingsFrame, Hint, OutlineButton from "./settings-kit.contract"

component WorkspaceSettingsScreen
  props
    page: Page
  view
    WorkspaceSettingsFrame(page=page, route="workspaceSettings", title="Workspace settings", lead="Computers, models and saved logins for this workspace.", listing=true)
      text "Choose a section to see or change what this workspace's Doods can use." class=Hint
      link href=path("workspaceComputers", page.workspaceId) class=OutlineButton align-self="start" testId="workspace-open-computers"
        text "Computers"
