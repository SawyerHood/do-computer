use CallMenu, CallRow from "./call.contract"
// The frame around everything behind sign-in, as the React app's AppShell
// (apps/web/src/components/shell): the sidebar of Doods under their workspaces with the account
// at its foot, the pill over a Dood's pages that leads to its other pages, and the scaffolds a
// Dood's page and a workspace's page are drawn in. data/shell.ts answers it.
use Session, Reply, Time, Viewport, Workspace, Workspaces, Dood, Doods, Page from "./shapes.contract"
use Frame, Screen, PrimaryButton, ListHeading, SidebarRow, RowName, RowLine, RowTime, IconButton, Pill, PillButton, Menu, MenuItem, PageTitle, PageLead from "./styles.contract"
use DoodFace from "./creature.contract"
use EmptyState from "exact:content"
use TeamInfo, TeamInbox, TeamMember, teamOf, TeamHint from "./teams.contract"
use SidebarDoodMenu from "./teams-sidebar.contract"
use AskCounts from "./chat-shapes.contract"
use HerePlace, HereFaces, peopleIn, namesOf from "./teams-here.contract"

// What a hatch answers: the new Dood, to open it.
shape Hatched
  ok: bool
  error: string
  agentId: string

// The open Dood's own socket (`/api/agents/:id/socket`), counted: `changes` goes up when
// something the sidebar shows changed, which asks for the Doods again.
shape DoodPulse
  agentId: string
  changes: number
  lost: bool
  // --- chat transcript --- what the chat shows of the Dood, counted (data/chat-asks.ts).
  asks: AskCounts

// The person's own feed (`/api/presence/personal:<user>`), counted the same way, for every Dood.
shape Feed
  owner: string
  changes: number
  lost: bool

members App
  // --- shell ---
  resource viewport = exactViewport() as shape Viewport
  resource time = exactTime() as shape Time
  // performanceNow() when the clock was last looked at, for "4m" beside a Dood.
  state tick = 0
  // Whether the open Dood's panel is beside its chat, on a wide window. Kept, as the React app keeps it.
  state panelOpen = false persist
  // The sidebar beside the page, as the React app's (lib/columns.ts, resize-handle.tsx): its edge
  // is dragged or moved by the arrow keys from 208 to 448, and past half way in to its narrowest
  // it is shut to a column of faces, 60 wide. Both are kept.
  state sidebarWidth = 288 persist
  state sidebarShut = true persist
  state sidebarDragging = false
  // Where the pointer was when the edge was taken, less where the edge was.
  state sidebarGrip = 0
  resource workspaces = loadWorkspaces(session.owner) as shape Workspaces else empty()
  resource pulse = followDood(session.owner, openAgentId) as shape DoodPulse else empty()
  resource feed = followFeed(session.owner, session.userId) as shape Feed else empty()
  resource doods = loadDoods(session.owner) with pulse.changes, feed.changes as shape Doods else empty()
  mutation hatched as shape Hatched refreshes doods then afterHatch
  mutation seen as shape Reply refreshes doods
  // The sidebar beside the page: Exact's web host splits a list from its detail from 900 px.
  derive wide = viewport.width >= 900
  derive now = time.epochAtZero + tick
  // Answers kept from another sign-in are never shown (data/api.ts `ownerOf`).
  derive doodList = doods.owner == session.owner ? doods.doods : []
  derive workspaceList = workspaces.owner == session.owner ? workspaces.workspaces : []
  derive openDood = doodOf(doodList, openAgentId)
  derive hatchError = pending(hatched) ? "" : match hatched { case some(r) => r.error, case none => "" }
  derive seenKey = `${openAgentId}:${openDood.latestAt}`

  // Every Dood's row is asked for again when the person's feed says it changed, as the React
  // app's are; the open Dood's name and creature when its own socket does. A socket that ended
  // is followed again.
  task clock mount
    every(30000, look)
  task mendPulse mount
    every(5000, healPulse)
  task seeing key=seenKey
    after(400, see)

  action pull
    if session.signedIn
      refresh doods
  action look
    tick = performanceNow()
  action healPulse
    if pulse.lost and openAgentId != ""
      refresh pulse
    if feed.lost and session.signedIn
      refresh feed
  // The Dood on screen is being looked at, so nothing of its is new.
  action see
    if openDood.unread and not pending(seen)
      send seen = markSeen(openAgentId)
  action hatch(workspaceId: string)
    if not pending(hatched)
      welcomeOn = false
      send hatched = hatchDood(workspaceId)
  action afterHatch
    match hatched
      case some(r)
        if r.ok and r.agentId != ""
          follow(path("dood", r.agentId))
      case none
        tick = tick
  action togglePanel
    panelOpen = not panelOpen
  action sidebarGrab(e: PointerEvent)
    if e.button == 0
      // No text is selected by the drag: a selection begun here would be dragged by the next one.
      preventDefault()
      sidebarGrip = e.clientX - (sidebarShut ? 60 : sidebarWidth)
      sidebarDragging = true
  action sidebarDrag(e: PointerEvent)
    if sidebarDragging
      if e.clientX - sidebarGrip < 134
        sidebarShut = true
      else
        sidebarShut = false
        sidebarWidth = round(min(448, max(208, e.clientX - sidebarGrip)))
  action sidebarDrop(e: PointerEvent)
    sidebarDragging = false
  // Pressed twice: shut, it opens; open, it is as wide as it started.
  action sidebarReset
    if sidebarShut
      sidebarShut = false
    else
      sidebarWidth = 288
  // One step out of being shut is being open, at the width it was left; one step in from its
  // narrowest is being shut.
  action sidebarKey(k: string)
    if sidebarShut
      if k == "ArrowRight" or k == "End"
        sidebarShut = false
    else if k == "Home" or (k == "ArrowLeft" and sidebarWidth <= 208)
      sidebarShut = true
    else if k == "ArrowLeft"
      sidebarWidth = max(208, sidebarWidth - 16)
    else if k == "ArrowRight"
      sidebarWidth = min(448, sidebarWidth + 16)
    else if k == "End"
      sidebarWidth = 448

fn doodOf(doods: Dood[], id: string): Dood = match first(doods.filter(d => d.id == id)) {
  case some(d) => d,
  case none => Dood(id=id, name="", workspaceId="", latest="", latestAt=0, working=false, asking=false, unread=false, seed=id, color="#5b6672", hatched=false, outfit="{}")
}
fn nameOf(d: Dood): string = d.name == "" ? "New Dood" : d.name
fn stateOf(d: Dood): string = d.asking ? "asking" : d.working ? "working" : "idle"

// When something last happened, in as few characters as say it: now, 4m, 1h, Tue, Sep 28.
fn weekdayOf(at: number, offset: number): string = match ["Thu", "Fri", "Sat", "Sun", "Mon", "Tue", "Wed"].at(floor((at + offset * 60000) / 86400000) % 7) { case some(d) => d, case none => "" }
fn dayOf(at: number, offset: number): string = match formatDate(at, offset, "medium").split(",").at(0) { case some(d) => d, case none => "" }
fn ago(at: number, now: number, offset: number): string =
  now - at < 60000 ? "now" : now - at < 3600000 ? `${floor((now - at) / 60000)}m` : now - at < 86400000 ? `${floor((now - at) / 3600000)}h` : now - at < 604800000 ? weekdayOf(at, offset) : dayOf(at, offset)

fn pageName(route: string): string = route == "dood" ? "Chat" : route == "library" ? "Library" : route == "automations" ? "Automations" : route == "skills" ? "Skills" : route == "connectors" ? "Connectors" : route == "computers" ? "Computers" : route == "permissions" ? "Permissions" : route == "profile" ? "Profile" : route == "settings" ? "Settings" : route == "memory" ? "Memory" : route == "model" ? "Model and computers" : route == "usage" ? "Usage" : route == "people" ? "People" : route == "workspaceSettings" ? "Workspace settings" : route == "workspace" ? "Workspace" : ""

// The sidebar: every workspace's Doods, under its name where there is more than one, and the
// account at the foot. It is the stack's first route, which a wide window shows beside the page.
component Sidebar
  props
    // The route entry's id.
    key: string
    current: string
  inject
    session: Session
    doodList: Dood[]
    workspaceList: Workspace[]
    now: number
    utcOffset: number
    wide: bool
    hatchError: string
    hatching: bool
    hatch: action
    signOut: action
    teamInbox: TeamInbox[]
    teamFolded: string[]
    teamNew: action
    teamFold: action
    teamReorder: action
    teamOrderError: string
    hereTeam: string
    hereOthers: HerePlace[]
    hereMembers: TeamMember[]
    sidebarWidth: number
    sidebarShut: bool
    sidebarDragging: bool
    sidebarGrab: action
    sidebarDrag: action
    sidebarDrop: action
    sidebarKey: action
    sidebarReset: action
  derive named = workspaceList.filter(w => w.kind == "team").length > 0
  derive shown = named ? workspaceList : workspaceList.filter(w => w.kind == "personal")
  // Shut to its faces: only beside the page, never a phone's list.
  derive rail = wide and sidebarShut
  view
    column navigationKey=key navigationSplit=`${rail ? 60 : sidebarWidth}` navigationScroll="sidebar-list" position="absolute" inset=0
      display="flex" flex-direction="column" class=Frame border-right=(wide ? "1px solid var(--hairline)" : "none") testId="sidebar"
      // The edge that is dragged, over the border (resize-handle.tsx).
      if wide
        box role="separator" aria-orientation="vertical" aria-label="Resize the sidebar" aria-valuemin=60 aria-valuemax=448 aria-valuenow=(rail ? 60 : sidebarWidth) tabindex=0
          position="absolute" top=0 bottom=0 right=-3 width=7 z-index=5 cursor="col-resize" touch-action="none" user-select="none"
          pointerdown=sidebarGrab pointermove=sidebarDrag pointerup=sidebarDrop dblclick=sidebarReset key=sidebarKey testId="sidebar-resize"
      // In no team, one list under "Doods"; in one, each workspace is under its own name instead.
      header appearance="none" display="flex" align-items="center" justify-content=(rail ? "center" : "flex-start") gap=2 min-height=(named ? 6 : 36) padding=(named ? "0" : rail ? "8px 0 0" : "8px 8px 0 16px")
        if not named
          if not rail
            text "Doods" role="heading" aria-level=1 flex=1 class=ListHeading
          for w in shown key=w.id
            if not rail
              WorkspaceMenuButton(workspace=w)
            button press=hatch(w.id) disabled=hatching aria-label="New Dood" class=IconButton testId="new-dood"
              image "symbol:icon.plus" color="ink.muted" font-size="0.75rem"
      scroll id="sidebar-list" flex=1 min-height=0 padding=(rail ? "2px 4px 12px" : "2px 8px 12px")
        if doodList.length == 0 and session.signedIn and not rail
          column padding="24px 8px" gap=12 align-items="flex-start"
            text "No Doods yet." class=RowLine font-size="0.875rem"
            text "A Dood is an agent of your own: it has a name, a memory and computers to work on." class=RowLine
            if hatchError != ""
              text hatchError color="danger" font-size="0.75rem" testId="hatch-error"
        for w in shown key=w.id
          column gap=2 margin-top=(shown.map(x => x.id).indexOf(w.id) > 0 ? 8 : 0) testId=`workspace-${w.id}`
            if named and rail
              // Only what fits over a face: the workspace's mark, which folds it, in the middle
              // of a line across the column (agent-list.tsx).
              row min-height=36 align-items="center" gap=2
                column flex=1 height=1 background-color="hairline"
                button press=teamFold(w.id) aria-label=w.name aria-expanded=(not teamFolded.includes(w.id)) title=w.name class=IconButton testId=`workspace-fold-${w.id}`
                  column width="1.125rem" height="1.125rem" border-radius=5 background-color=(w.kind == "personal" ? session.color : w.color) align-items="center" justify-content="center" flex-shrink=0
                    text (w.kind == "personal" ? session.initials : w.name.slice(0, 1).toUpperCase()) color="ink.on-color" font-size=(w.kind == "personal" ? "0.5rem" : "0.625rem") font-weight=600
                column flex=1 height=1 background-color="hairline"
            else if named
              row min-height=36 align-items="center" gap=6 padding="0 0 0 8px"
                // The workspace's mark: one's own has one's initials (WorkspaceMark).
                column width="1.125rem" height="1.125rem" border-radius=5 background-color=(w.kind == "personal" ? session.color : w.color) align-items="center" justify-content="center" flex-shrink=0
                  text (w.kind == "personal" ? session.initials : w.name.slice(0, 1).toUpperCase()) color="ink.on-color" font-size=(w.kind == "personal" ? "0.5rem" : "0.625rem") font-weight=600
                button press=teamFold(w.id) aria-label=`${teamFolded.includes(w.id) ? "Expand" : "Collapse"} ${w.name}` aria-expanded=(not teamFolded.includes(w.id)) flex=1 min-width=0 class=IconButton justify-content="flex-start" gap=4 testId=`workspace-fold-${w.id}`
                  text w.name class=ListHeading flex="0 1 auto" min-width=0 text-align="start" overflow="hidden" text-overflow="ellipsis" white-space="nowrap"
                  image (teamFolded.includes(w.id) ? "symbol:icon.caret-right" : "symbol:icon.caret-down") width="0.625rem" height="0.625rem" flex-shrink=0
                if teamFolded.includes(w.id) and doodList.filter(d => d.workspaceId == w.id and (d.unread or d.asking)).length > 0
                  text "New" color="notice" font-size="0.75rem"
                // Folded, it still says who is in there (agent-list.tsx).
                if teamFolded.includes(w.id) and w.id == hereTeam and peopleIn(hereOthers, hereMembers).length > 0
                  text `${peopleIn(hereOthers, hereMembers).length} here` aria-label=`${peopleIn(hereOthers, hereMembers).length} here now: ${namesOf(peopleIn(hereOthers, hereMembers))}` color="ink.muted" font-size="0.75rem" testId=`workspace-here-${w.id}`
                WorkspaceMenuButton(workspace=w)
                button press=hatch(w.id) disabled=hatching aria-label=`New Dood in ${w.name}` class=IconButton testId=`new-dood-${w.id}`
                  image "symbol:icon.plus" color="ink.muted" font-size="0.75rem"
            if not named or not teamFolded.includes(w.id)
              list id=`dood-order-${w.id}` virtualized=true height=`${doodList.filter(x => x.workspaceId == w.id).length * (rail ? 54 : 61)}px` flex-shrink=0 appearance="none" reorderdrop=teamReorder(w.id) aria-label=`${w.name} Doods` testId=`dood-list-${w.id}`
                for d in doodList.filter(x => x.workspaceId == w.id) key=d.id
                  DoodRow(dood=d, current=(d.id == current), now=now, utcOffset=utcOffset, rail=rail)
              if doodList.filter(x => x.workspaceId == w.id).length == 0
                text (w.kind == "team" ? "This team has no Doods yet." : "You have no Doods yet.") class=TeamHint padding="8px 10px"
        if teamOrderError != ""
          text teamOrderError color="danger" role="alert" font-size="0.75rem" padding=8 testId="sidebar-action-error"
        if not rail
          column margin-top=12 padding-top=8 border-top="1px solid var(--hairline)" gap=4
            for i in teamInbox key=i.id
              link href=path("invite", i.id) class=MenuItem testId=`team-inbox-${i.id}`
                text `${i.name} invited you`
            button press=teamNew class=MenuItem color="ink.muted" testId="new-team"
              image "symbol:icon.plus" width="1rem" height="1rem"
              text "New team" font-size="0.8125rem"
      AccountButton(session=session, rail=rail)
      NoDood()

// A workspace's own menu, from the … beside its name: its settings, its people.
component WorkspaceMenuButton
  props
    workspace: Workspace
  inject
    teamInvite: action
    teamSortLatest: action
    follow: action
  action choose(url: string)
    hidePopover(`workspace-menu-${workspace.id}`)
    follow(url)
  action invite
    hidePopover(`workspace-menu-${workspace.id}`)
    teamInvite(workspace.id)
  action sort
    hidePopover(`workspace-menu-${workspace.id}`)
    teamSortLatest(workspace.id)
  // Its test ids: "personal" for the person's own, which has an id of theirs, else the team's id.
  derive tag = workspace.kind == "personal" ? "personal" : workspace.id
  view
    row
      button popovertarget=`workspace-menu-${workspace.id}` aria-label=`${workspace.name}: workspace menu` class=IconButton testId=`workspace-menu-${tag}`
        image "symbol:icon.dots" color="ink.muted" font-size="1rem"
      column id=`workspace-menu-${workspace.id}` popover="auto" role="menu" aria-label=workspace.name class=Menu
        link href=path("workspaceSettings", workspace.id) press=choose(path("workspaceSettings", workspace.id)) role="menuitem" class=MenuItem testId=`workspace-settings-${tag}`
          image "symbol:icon.gear" aria-hidden=true
          text "Workspace settings"
        if workspace.kind == "team" and workspace.role != "member"
          button press=invite role="menuitem" class=MenuItem testId=`workspace-invite-${tag}`
            image "symbol:icon.user-plus" aria-hidden=true
            text "Invite people"
        button press=sort role="menuitem" class=MenuItem testId=`workspace-sort-${tag}`
          image "symbol:icon.sort-ascending" aria-hidden=true
          text "Sort by latest"
        if workspace.kind == "team"
          link href=path("people", workspace.id) press=choose(path("people", workspace.id)) role="menuitem" class=MenuItem testId=`workspace-people-${tag}`
            image "symbol:icon.users" aria-hidden=true
            text "People"

// One Dood in the sidebar: its face, its name, when it last said something, and that line.
// Choosing it is talking to it: the row opens its main chat.
component DoodRow
  props
    dood: Dood
    current: bool
    now: number
    utcOffset: number
    // In the sidebar shut to its faces: the face alone, which carries the row's marks.
    rail: bool
  inject
    hovers: bool
  // The pointer is over the row, or the keys are on its menu.
  state over = false
  state onMenu = false
  action pointed(is: bool)
    over = is
  action menuFocused
    onMenu = true
  action menuLeft
    onMenu = false
  // The row's menu (and its grip) take the time's place while the row is pointed at, as the
  // React app's does; where nothing can point (a touch screen) they are always there.
  derive acting = not hovers or over or onMenu
  view
    row position="relative" align-items="center" border-radius="0.7rem" background-color=(current ? "wash" : "transparent") hover=pointed
      height=(rail ? 52 : 59) margin-bottom=2
      :hover
        background-color="wash"
      link href=path("dood", dood.id) aria-label=(rail and dood.unread ? `Talk to ${nameOf(dood)}: something new` : `Talk to ${nameOf(dood)}`) title=(rail ? nameOf(dood) : "") aria-current=(current ? "page" : "false") aria-selected=current class=SidebarRow flex=1 min-width=0
        padding=(rail ? "6px" : "0 10px 0 8px") align-self="stretch" justify-content=(rail ? "center" : "flex-start") testId=`dood-${dood.id}`
        column position="relative" flex-shrink=0
          DoodFace(seed=dood.seed, color=dood.color, state=stateOf(dood), name=nameOf(dood), size=40)
          if dood.asking
            column position="absolute" right=-2 bottom=-2 width="0.875rem" height="0.875rem" border-radius=7 background-color="asking"
              align-items="center" justify-content="center" box-shadow="0 0 0 2px var(--frame)" role="img" aria-label="Waiting on someone"
              text "?" color="ink.on-asking" font-size="0.625rem" font-weight=700 aria-hidden=true
          else if rail and dood.working
            column position="absolute" right=-2 bottom=-2 width="0.875rem" height="0.875rem" border-radius=7 background-color="canvas"
              align-items="center" justify-content="center" box-shadow="0 0 0 2px var(--frame)"
              progress aria-label="Working" width=10 height=10 testId=`dood-working-${dood.id}`
          if rail and dood.unread
            column position="absolute" right=-2 top=-2 width="0.75rem" height="0.75rem" border-radius=6 background-color="notice"
              box-shadow="0 0 0 2px var(--frame)" role="img" aria-label="Something new" testId=`dood-unread-${dood.id}`
        if not rail
          DoodRowWords(dood=dood, now=now, utcOffset=utcOffset, acting=acting)
      if not rail
        column position="absolute" top=5 right=4 opacity=(acting ? 1 : 0) focus=menuFocused blur=menuLeft
          SidebarDoodMenu(dood=dood)

// What a row says beside its face: the name, who is with it, when, and its latest line.
component DoodRowWords
  props
    dood: Dood
    now: number
    utcOffset: number
    // The row's menu is over where the time is.
    acting: bool
  inject
    hereOthers: HerePlace[]
    hereMembers: TeamMember[]
    wide: bool
  // Who else is with it now, in the team on screen (agent-list.tsx `with_`).
  derive with = peopleIn(hereOthers.filter(p => p.agentId == dood.id), hereMembers)
  view
    column flex=1 min-width=0 gap=1
      row align-items="baseline" gap=8
        text nameOf(dood) flex=1 min-width=0 class=RowName line-height="1.359375rem" font-weight=(dood.unread ? 600 : 500)
          overflow="hidden" text-overflow="ellipsis" white-space="nowrap" testId=`dood-name-${dood.id}`
        if with.length > 0
          row aria-label=`With ${nameOf(dood)} now: ${namesOf(with)}` role="img" flex-shrink=0 testId=`dood-here-${dood.id}`
            HereFaces(people=with, size=16)
        if acting
          // Room for the menu and, in a wide window, the grip beside it.
          column width=(wide ? 44 : 22) height=14 flex-shrink=0 aria-hidden=true
        else if dood.working
          progress aria-label="Working" width=14 height=14 testId=`dood-working-${dood.id}`
        else if dood.latestAt > 0
          text ago(dood.latestAt, now, utcOffset) class=RowTime color=(dood.unread ? "notice" : "ink.muted") font-weight=(dood.unread ? 500 : 400)
      if dood.latest != "" or dood.unread
        row align-items="center" gap=6
          CallRow(agentId=dood.id)
            text dood.latest flex=1 min-width=0 class=RowLine color=(dood.unread ? "ink" : "ink.muted")
              overflow="hidden" text-overflow="ellipsis" white-space="nowrap" testId=`dood-latest-${dood.id}`
          if dood.unread
            column width=8 height=8 border-radius=4 background-color="notice" flex-shrink=0 role="img" aria-label="Something new" testId=`dood-unread-${dood.id}`

// The person's own menu, at the foot of the sidebar: signing out.
component AccountButton
  props
    session: Session
    // In the sidebar shut to its faces: the face alone.
    rail: bool
  inject
    signOut: action
    openAccountSettings: action
  view
    column padding=(rail ? "6px 4px" : "6px 8px")
      button popovertarget="account-menu" aria-label=`${session.name}: settings and signing out`
        display="flex" align-items="center" justify-content=(rail ? "center" : "flex-start") gap=10 padding="6px 8px" border-radius=12 background-color="transparent" border="none"
        color="ink" testId="account"
        :hover
          background-color="wash"
        column width="1.75rem" height="1.75rem" border-radius=14 background-color=session.color align-items="center" justify-content="center" flex-shrink=0
          text session.initials color="ink.on-color" font-size="0.625rem" font-weight=600
        if not rail
          text session.name flex=1 min-width=0 font-size="0.875rem" text-align="start" overflow="hidden" text-overflow="ellipsis" white-space="nowrap" testId="account-name"
          image "symbol:icon.caret-up-down" aria-hidden=true color="ink.muted"
      column id="account-menu" popover="auto" role="menu" aria-label=session.email class=Menu
        // --- settings: the way into the person's own ---
        button role="menuitem" press=openAccountSettings popovertarget="account-menu" popovertargetaction="hide" class=MenuItem testId="account-settings"
          image "symbol:icon.gear" aria-hidden=true
          text "Settings"
        button role="menuitem" press=signOut popovertarget="account-menu" popovertargetaction="hide" class=MenuItem testId="sign-out"
          image "symbol:icon.sign-out" aria-hidden=true
          text "Sign out"

// What is over a Dood's pages, as the React app's AgentStrip: on a phone the way back to the
// list, then the pill with its face and name, whose menu goes to its other pages.
component DoodHeader
  props
    page: Page
    // The route the page is: "dood" (its chat), "library", …
    route: string
  inject
    doodList: Dood[]
    wide: bool
    panelOpen: bool
    togglePanel: action
    back: action
    openWardrobe: action
  derive dood = doodOf(doodList, page.agentId)
  derive menu = `pages-${page.key}`
  view
    header appearance="none" display="flex" flex-wrap="wrap" align-items="center" gap=8 padding="4px 10px" min-height=52 flex-shrink=0
      if not wide
        button id="back" press=back aria-label="Your Doods" class=IconButton min-width="2.25rem" min-height="2.25rem" border-radius=999
          box-shadow="0 0 0 1px var(--hairline)" testId=`back-${route}`
          image "symbol:icon.sidebar"
      row flex="1 1 12rem" min-width=0 justify-content="center"
        row class=Pill max-width="100%" min-width=0
          if wide
            button press=togglePanel aria-label=(panelOpen ? `Hide ${nameOf(dood)}'s panel` : `Show ${nameOf(dood)}'s panel`) aria-pressed=panelOpen
              padding=2 border-radius=999 background-color="transparent" border="none" testId=`panel-toggle-${route}`
              DoodFace(seed=dood.seed, color=dood.color, state=stateOf(dood), name=nameOf(dood), size=28)
          else
            button press=openWardrobe disabled=(not dood.hatched) aria-label=`${nameOf(dood)}'s wardrobe` padding=2 border-radius=999 background-color="transparent" border="none" testId=`pill-wardrobe-${route}`
              DoodFace(seed=dood.seed, color=dood.color, state=stateOf(dood), name=nameOf(dood), size=28)
          button popovertarget=menu aria-label=`${nameOf(dood)}: pages and settings` class=PillButton min-width=0 flex-wrap="wrap" justify-content="center" testId=`pages-${route}`
            text nameOf(dood) role="heading" aria-level=1 font-size="0.875rem" font-weight=500
              overflow="hidden" text-overflow="ellipsis" white-space="nowrap" testId=`title-${route}`
            if route != "dood" and route != "chat" and route != "library"
              text ` · ${pageName(route)}` font-size="0.875rem" color="ink.muted" min-width=0 overflow-wrap="break-word"
            image "symbol:icon.caret-down" aria-hidden=true color="ink.muted" font-size="0.75rem"
      // As wide as the way back, so the pill stays in the middle.
      if not wide
        column flex="0 1 2.25rem" min-width=0 height=0 aria-hidden=true
      column id=menu popover="auto" role="menu" aria-label=`${nameOf(dood)}'s pages` class=Menu
        PageLink(href=path("dood", page.agentId), label="Chat", on=(route == "dood" or route == "chat"), testId=`go-chat-${route}`)
        PageLink(href=path("library", page.agentId), label="Library", on=(route == "library"), testId=`go-library-${route}`)
        PageLink(href=path("automations", page.agentId), label="Automations", on=(route == "automations"), testId=`go-automations-${route}`)
        hr
        PageLink(href=path("skills", page.agentId), label="Skills", on=(route == "skills"), testId=`go-skills-${route}`)
        PageLink(href=path("connectors", page.agentId), label="Connectors", on=(route == "connectors"), testId=`go-connectors-${route}`)
        PageLink(href=path("computers", page.agentId), label="Computers", on=(route == "computers"), testId=`go-computers-${route}`)
        PageLink(href=path("permissions", page.agentId), label="Permissions", on=(route == "permissions"), testId=`go-permissions-${route}`)
        hr
        CallMenu(route=route)
        PageLink(href=path("profile", page.agentId), label="Profile", on=(route == "profile"), testId=`go-profile-${route}`)
        PageLink(href=path("settings", page.agentId), label=`${nameOf(dood)}'s settings`, on=(route == "settings"), testId=`go-settings-${route}`)

// One of a Dood's pages in its pill's menu, ticked when it is the one open.
component PageLink
  props
    href: string
    label: string
    on: bool
    testId: string
  view
    link href=href role="menuitem" aria-current=(on ? "page" : "false") class=MenuItem testId=testId
      text label flex=1
      if on
        image "symbol:icon.check" aria-hidden=true

// The frame of one of a Dood's pages other than its chat: the header, then the page's title,
// a line under it, and what the page holds (the use's children). An area's screen is one use.
component DoodScreen
  props
    page: Page
    route: string
    lead: string
  slot
  inject
    wide: bool
  view
    column navigationKey=page.key navigationScroll=`scroll-${page.key}` position="absolute" inset=0 display="flex" flex-direction="column"
      class=Screen testId=`screen-${route}`
      DoodHeader(page=page, route=route)
      scroll id=`scroll-${page.key}` flex=1 min-height=0
        // The React app's page column (`max-w-2xl px-6`).
        column max-width="42rem" margin="0 auto" padding=(wide ? "28px 24px 96px" : "16px 16px 40px") gap=24 box-sizing="border-box" width="100%"
          column gap=6
            text pageName(route) role="heading" aria-level=2 class=PageTitle hyphens="auto" overflow-wrap="break-word" testId=`heading-${route}`
            if lead != ""
              text lead class=PageLead
          children

// The frame of a workspace's own page: its name over the page, as the React app's team pages.
component WorkspaceScreen
  props
    page: Page
    route: string
    lead: string
  slot
  inject
    workspaceList: Workspace[]
    wide: bool
    back: action
  derive name = match first(workspaceList.filter(w => w.id == page.workspaceId)) { case some(w) => w.name, case none => "" }
  view
    column navigationKey=page.key navigationScroll=`scroll-${page.key}` position="absolute" inset=0 display="flex" flex-direction="column"
      class=Screen testId=`screen-${route}`
      header appearance="none" display="flex" align-items="center" gap=6 padding="6px 10px" min-height=52 flex-shrink=0
        if not wide
          button id="back" press=back aria-label="Your Doods" class=IconButton min-width="2.25rem" min-height="2.25rem" border-radius=999
            box-shadow="0 0 0 1px var(--hairline)" testId=`back-${route}`
            image "symbol:icon.sidebar"
        text name role="heading" aria-level=1 font-size="0.9375rem" font-weight=600 padding="0 4px" testId=`title-${route}`
      scroll id=`scroll-${page.key}` flex=1 min-height=0
        column max-width="52rem" margin="0 auto" padding=(wide ? "28px 32px 48px" : "16px 16px 40px") gap=20 box-sizing="border-box" width="100%"
          column gap=6
            text pageName(route) role="heading" aria-level=2 class=PageTitle hyphens="auto" overflow-wrap="break-word" testId=`heading-${route}`
            if lead != ""
              text lead class=PageLead
          children

// What a wide window shows beside the sidebar while no Dood is open.
component NoDood
  inject
    doodList: Dood[]
    workspaceList: Workspace[]
    hatching: bool
    hatch: action
  view
    column navigationSplit="placeholder" flex=1 min-height=0 align-items="center" justify-content="center" class=Screen
      if doodList.length == 0
        EmptyState(symbol="symbol:sparkles", title="No Doods yet", message="A Dood is an agent of your own: it has a name, a memory and computers to work on.")
          for w in workspaceList.filter(x => x.kind == "personal") key=w.id
            button press=hatch(w.id) disabled=hatching class=PrimaryButton testId="first-dood"
              text "Hatch a Dood"
      else
        EmptyState(symbol="symbol:messages", title="Pick a Dood", message="Choose one in the sidebar to talk to it.")
