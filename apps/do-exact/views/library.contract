// A Dood's library page: a PLACEHOLDER until its area is built. It will hold the pinned documents, all files with their filter, a document open beside the list, new documents and uploads.
// The React app's is apps/web/src/routes/_app.a.$agentId.library.tsx. To build it: give this file a `members App` block for its
// resources, mutations and actions (listed in app.contract beside the others), and its data
// sources in data/library.ts (gathered in app.ts); then pass what the screen reads as props where
// app.contract draws it. Keep the DoodScreen frame: it is the header, the title and the lead.
use Page from "./shapes.contract"
use DoodScreen from "./shell.contract"

component LibraryScreen
  props
    page: Page
  view
    DoodScreen(page=page, route="library", lead="Documents and files made by the Doods of this workspace, and ones you have given them. Every Dood in the workspace shares this library, and what is in it is kept here whatever happens to a computer.")
      text "Not in this app yet." font-size="0.875rem" color="ink.muted" testId="placeholder-library"
