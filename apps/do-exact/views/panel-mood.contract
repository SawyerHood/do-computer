use callMood from "./call.contract"
// What a Dood's creature is doing, everywhere it is drawn (lib/use-mascot-mood.ts): the open
// Dood's as its chat says (thinking, working at what kind of work, answering), with what goes on
// around it (the person typing, a run that just finished or failed, an OK it waits for, a page
// left quiet for a while); every other Dood's as the list of them says. `liveFaces` is what
// DoodFace and Hatchling (creature.contract) draw.
use Dood from "./shapes.contract"
use Chat from "./chat-shapes.contract"
use Face from "./creature.contract"

// What a creature acts out: a state and, for working, which kind of work.
shape Mood
  state: string
  variant: string

members App
  // --- panel mood ---
  // The draft as it was when it was last typed in: listening stops 2.5 s after the last key.
  state moodHeard = ""
  // A run that was going has stopped: done or error for a moment after.
  state moodWasBusy = false
  state moodEnd = ""
  // The quiet it dozed off in: it sleeps until anything changes.
  state moodDozed = ""
  // It thinks about what was said from the moment it is said.
  derive openBase = not ours ? Mood(state="idle", variant="") : pending(said) and not chat.busy ? Mood(state="thinking", variant="") : chatMood(chat)
  derive quietKey = `${openAgentId}:${draft}:${chat.messages.length}:${chat.busy}:${moodEnd}`
  derive openMood = openBase.state != "idle" and openBase.state != "error" ? openBase : moodEnd != "" ? Mood(state=moodEnd, variant="") : openDood.asking ? Mood(state="waiting", variant="") : draft != "" and draft != moodHeard ? Mood(state="listening", variant="") : moodDozed == quietKey ? Mood(state="asleep", variant="") : Mood(state="idle", variant="")
  derive liveFaces = doodList.map(d => callMood(liveFace(d, openAgentId, openMood, hatchingFor, hatchedHere), callView))
  derive liveSeeds = liveFaces.map(f => f.seed)

  task listening key=draft
    after(2500, heardDraft)
  task moodTurn key=`${chat.agentId}:${chat.busy}`
    after(1, turnMood)
  // After being pleased it settles by itself; troubled, it takes longer.
  task moodSettleDone when moodEnd == "done" key=moodEnd
    after(1800, settleMood)
  task moodSettleError when moodEnd == "error" key=moodEnd
    after(8000, settleMood)
  task dozing key=quietKey
    after(240000, dozeOff)
  action heardDraft
    moodHeard = draft
  action turnMood
    if moodWasBusy and not chat.busy and ours
      match chat.messages.at(-1)
        case some(m)
          if m.role == "assistant" and m.status != "aborted"
            moodEnd = m.status == "error" ? "error" : "done"
        case none
          moodEnd = moodEnd
    if chat.busy
      moodEnd = ""
    moodWasBusy = chat.busy
  action settleMood
    moodEnd = ""
  action dozeOff
    moodDozed = quietKey

// What the agent is doing, for its creature to act out: the protocol's own `chatMood`, which
// data/chat.ts reads off the whole chat, its last `send` and its tool calls among it.
fn chatMood(chat: Chat): Mood = Mood(state=chat.moodState, variant=chat.moodVariant)
// A Dood's creature as it is now: the open one as its chat says, the rest as the list says.
fn liveFace(d: Dood, openId: string, mood: Mood, hatchingFor: string, hatchedHere: string): Face = Face(id=d.id, seed=d.seed, state=(d.id == openId ? mood.state : d.asking ? "waiting" : d.working ? "working" : "idle"), variant=(d.id == openId ? mood.variant : ""), outfit=d.outfit, hatched=(d.hatched or hatchedHere.includes(`|${d.id}|`)), hatching=(hatchingFor == d.id and not hatchedHere.includes(`|${d.id}|`)))
