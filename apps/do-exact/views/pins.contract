use Reply from "./shapes.contract"
use LibraryMarkdown from "./library-markdown.contract"
use LibraryFile, Library from "./library-shapes.contract"
use LibraryViewer from "./library-viewer.contract"
use MenuItem from "./styles.contract"

shape LibraryPin
  fileId: string
  currentId: string
  title: string
  missing: bool
  kind: string
  url: string
  preview: string
  when: string

shape LibraryPins
  owner: string
  agentId: string
  pins: LibraryPin[]

members App
  // --- library pins ---
  resource libraryPins = loadLibraryPins(session.owner, onRoute == "library" or libraryPanelId != "" or panelOpen ? openAgentId : "") with libraryPulse.changes, libraryFiles as shape LibraryPins else empty()
  mutation libraryPinnedReply as shape Reply refreshes libraryPins
  derive libraryPinList = libraryPins.owner == session.owner and libraryPins.agentId == openAgentId ? libraryPins.pins : []
  derive libraryPinned = libraryPinList.map(p => p.currentId == librarySelected.id).includes(true)
  derive libraryPinError = pending(libraryPinnedReply) ? "" : match libraryPinnedReply { case some(r) => r.error, case none => "" }
  action libraryPin
    let p = match first(libraryPinList.filter(p => p.currentId == librarySelected.id)) { case some(p) => p.fileId, case none => librarySelected.id }
    send libraryPinnedReply = pinLibrary(openAgentId, p, not libraryPinned)
  action libraryTogglePinFile(fileId: string)
    let p = match first(libraryPinList.filter(p => p.currentId == fileId)) { case some(p) => p.fileId, case none => "" }
    send libraryPinnedReply = pinLibrary(openAgentId, p == "" ? fileId : p, p == "")
  action libraryUnpin(fileId: string)
    send libraryPinnedReply = pinLibrary(openAgentId, fileId, false)

component PinsShelf
  inject
    libraryPinList: LibraryPin[]
    libraryUnpin: action
    openLibraryPanel: action
    libraryPinError: string
  view
    if libraryPinList.length > 0
      column gap=8 padding=12 testId="library-pins"
        text "Pinned" font-size="0.8125rem" color="ink.muted"
        for p, i in libraryPinList key=p.fileId
          column border-radius=12 background-color="popover" border="1px solid var(--hairline)" overflow="hidden"
            if i == 0 and not p.missing and (p.kind == "image" or p.kind == "markdown" or p.kind == "page")
              button press=openLibraryPanel(p.currentId) padding=0 border="none" background-color="transparent" height=160 overflow="hidden" aria-label=`Open ${p.title}` testId="library-pin-preview"
                if p.kind == "image"
                  image p.url alt="" width="100%" height=160 object-fit="cover"
                else if p.kind == "markdown"
                  column padding=16 max-height=160 overflow="hidden" text-align="start"
                    LibraryMarkdown(text=p.preview)
                else
                  iframe src=p.url title=`Preview of ${p.title}` sandbox="allow-scripts" tabindex=-1 pointer-events="none" border="none" width="200%" height=320 transform="scale(0.5)" transform-origin="left top"
            row gap=6 align-items="center" padding=6
              if p.missing
                text `${p.title} is no longer in the library` flex=1 min-width=0 font-size="0.8125rem" color="ink.muted" overflow-wrap="break-word" testId=`pin-missing-${p.fileId}`
              else
                button press=openLibraryPanel(p.currentId) class=MenuItem flex=1 min-width=0 testId=`pin-open-${p.fileId}`
                  text p.title font-size="0.875rem" overflow-wrap="break-word"
              if not p.missing
                text p.when color="ink.muted" font-size="0.6875rem"
              button press=libraryUnpin(p.fileId) aria-label=`Unpin ${p.title}` testId=`pin-remove-${p.fileId}`
                image "symbol:pin"
        if libraryPinError != ""
          text libraryPinError color="danger" role="alert" font-size="0.8125rem" testId="library-pin-error"

// Chat's file cards call openLibraryPanel(fileId), and mount this beside their transcript.
component LibraryDocumentPanel
  inject
    libraryPanelId: string
    librarySelected: LibraryFile
    libraryFiles: LibraryFile[]
    libraryOpen: action
    closeLibraryPanel: action
    wide: bool
  view
    if libraryPanelId != ""
      column position="absolute" right=0 top=56 bottom=0 background-color="canvas" box-shadow="-6px 0 24px rgb(0 0 0 / 0.06)" width=(wide ? "26rem" : "100%") min-width=0 min-height=0 border-left="1px solid var(--hairline)" testId="library-document-panel"
        row justify-content="flex-end" gap=6 padding=6
          button press=libraryOpen(librarySelected.id) testId="library-panel-expand"
            text "Open in the Library"
          button press=closeLibraryPanel aria-label="Close the document" testId="library-panel-close"
            image "symbol:close"
        if librarySelected.id == ""
          text "That file is no longer in the library. It may be under Recently deleted." padding=24 font-size="0.875rem" color="ink.muted" testId="library-panel-missing"
        else
          LibraryViewer(file=librarySelected, compact=true)

// Until chat adopts PinsShelf as a child, this occupies its existing Dood panel's lower half.
component LibraryPinsDock
  inject
    wide: bool
    panelOpen: bool
  view
    if wide and panelOpen
      scroll height="calc(100% - 260px)" position="absolute" right=0 top=260 bottom=0 width="20rem" background-color="canvas" testId="library-pin-dock"
        PinsShelf()
