// A Dood's skills page: a PLACEHOLDER until its area is built. It will hold the skills, each to read, turn off or remove, and adding one.
// The React app's is apps/web/src/components/settings/skills.tsx. To build it: give this file a `members App` block for its
// resources, mutations and actions (listed in app.contract beside the others), and its data
// sources in data/skills.ts (gathered in app.ts); then pass what the screen reads as props where
// app.contract draws it. Keep the DoodScreen frame: it is the header, the title and the lead.
use Page from "./shapes.contract"
use DoodScreen from "./shell.contract"

component SkillsScreen
  props
    page: Page
  view
    DoodScreen(page=page, route="skills", lead="What your Dood knows how to do, beyond what it was born knowing.")
      text "Not in this app yet." font-size="0.875rem" color="ink.muted" testId="placeholder-skills"
