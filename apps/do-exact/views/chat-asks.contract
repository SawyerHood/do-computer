// What the Dood waits on someone for, over the composer in every chat of it, as the React app's
// PendingApprovals (approvals.tsx), PendingSecrets and PendingSignIns (secrets.tsx): leave to do
// something, secrets or a login to type, a connector to sign in to. What is typed is held in the
// card until it is sent, and goes nowhere else.
use Card, OutlineButton, QuietButton, PrimaryButton, Field, FieldLabel from "./styles.contract"
use ApprovalAsk, SecretAsk, SecretField, SignInAsk, ComputerAsk from "./chat-shapes.contract"

component Asks
  props
    agentId: string
    // The Dood's name, as each card says who asks.
    name: string
    // The chat on screen: an ask from another one says where it came from.
    chatId: string
  inject
    pendingApprovals: ApprovalAsk[]
    pendingSecrets: SecretAsk[]
    pendingSignIns: SignInAsk[]
    pendingComputers: ComputerAsk[]
    // In a team, anyone in it can answer.
    chatTeam: string
  derive team = chatTeam
  view
    if pendingApprovals.length > 0
      column width="100%" max-width="48rem" margin="0 auto" padding="0 16px 8px" box-sizing="border-box" gap=8 flex-shrink=0
        role="list" aria-label="Waiting for your OK" testId="approvals"
        for r, i in pendingApprovals key=r.id
          ApprovalCard(request=r, at=i, agentId=agentId, name=name, here=(r.chatId == chatId), team=team)
    if pendingComputers.length > 0
      column width="100%" max-width="48rem" margin="0 auto" padding="0 16px 8px" box-sizing="border-box" gap=8 flex-shrink=0
        role="list" aria-label="Computers it asked to use" testId="computer-asks"
        for c, i in pendingComputers key=c.id
          ComputerCard(ask=c, at=i, name=name)
    if pendingSignIns.length > 0
      column width="100%" max-width="48rem" margin="0 auto" padding="0 16px 8px" box-sizing="border-box" gap=8 flex-shrink=0
        role="list" aria-label="Connectors to sign in to" testId="sign-ins"
        for c, i in pendingSignIns key=c.id
          SignInCard(connector=c, at=i, name=name)
    if pendingSecrets.length > 0
      scroll width="100%" max-width="48rem" margin="0 auto" padding="0 16px 8px" box-sizing="border-box" max-height="60vh" flex-shrink=0
        role="list" aria-label="Secrets it asked for" testId="secret-asks"
        column gap=8
          for s, i in pendingSecrets key=s.id
            if s.kind == "login"
              LoginCard(ask=s, at=i, agentId=agentId, name=name, here=(s.chatId == chatId), team=team)
            else
              SecretCard(ask=s, at=i, agentId=agentId, name=name, here=(s.chatId == chatId), team=team)

// Where an ask came from, when that is not the chat on screen.
component AskedIn
  props
    agentId: string
    chatId: string
    lead: string
    title: string
  view
    row flex-wrap="wrap" font-size="0.75rem" color="ink.muted"
      text lead white-space="pre"
      link href=path("chat", agentId, chatId) color="ink.muted" text-decoration="underline"
        text title

// One thing the Dood asks leave for: what, the specifics, and the three answers.
component ApprovalCard
  props
    request: ApprovalAsk
    // Its place in the list, for its test ids.
    at: number
    agentId: string
    name: string
    here: bool
    team: string
  inject
    answerApproval: action
    answering: bool
    answerError: string
  // A card's security code, typed with a yes, held here until it is sent.
  state typed = ""
  derive ready = request.wants == "" or (typed.length >= 3 and typed.length <= 4 and parseNumber(typed) != none)
  view
    column gap=10 padding=14 border-radius=16 class=Card role="listitem" testId=`approval-${at}`
      row gap=10 align-items="flex-start"
        image "symbol:icon.shield-check" color="ink.muted" aria-hidden=true margin-top=2 flex-shrink=0
        column flex=1 min-width=0 gap=2
          text font-size="0.875rem" testId=`approval-title-${at}`
            text name font-weight=500
            text " wants to: "
            text request.title font-weight=500
          if not here
            AskedIn(agentId=agentId, chatId=request.chatId, lead=(request.chatKind == "schedule" ? "In the scheduled run " : request.chatKind == "subagent" ? "From the sub-agent " : request.chatKind == "agent" ? "In a conversation with another Dood " : request.chatKind == "slack" ? "In the Slack thread " : "In the chat "), title=request.chatTitle)
          if request.chatKind == "subagent" and request.task != ""
            // A sub-agent reads what it finds, and what it finds can ask for things in its name.
            text `Asked while working on: “${request.task}”. Allow it only if you expected it.` font-size="0.75rem" color="ink.muted"
      if request.detail != ""
        text request.detail font-family="Geist Mono" font-size="0.75rem" white-space="pre-wrap" overflow-wrap="break-word"
          max-height=160 overflow="auto" padding="8px 12px" border-radius=8 background-color="muted" testId=`approval-detail-${at}`
      if request.wants != ""
        column gap=6
          text request.wants class=FieldLabel
          input type="password" inputmode="numeric" autocomplete="off" maxlength=4 value=typed input=editTyped submit=allowOnce disabled=answering
            aria-label=request.wants class=Field width="6rem" font-family="Geist Mono" testId=`approval-typed-${at}`
      if answerError != ""
        text answerError role="alert" font-size="0.875rem" color="danger"
      row gap=8 flex-wrap="wrap" align-items="center"
        button press=allowOnce disabled=(answering or not ready) class=PrimaryButton testId=`allow-once-${at}`
          text "Allow once"
        // Asked about every time, "always" changes nothing.
        if not request.onceOnly
          button press=allowAlways disabled=answering class=OutlineButton min-height="2.125rem" testId=`allow-always-${at}`
            text "Always allow"
        button press=deny disabled=answering class=QuietButton min-height="2.125rem" testId=`deny-${at}`
          text "Don’t allow"
        if team != ""
          text `Anyone in ${team} can answer` margin-left="auto" font-size="0.75rem" color="ink.muted"
  action editTyped(v: string)
    typed = v
  action allowOnce
    if ready
      answerApproval(request.id, "once", typed)
      typed = ""
  action allowAlways
    answerApproval(request.id, "always", typed)
    typed = ""
  action deny
    answerApproval(request.id, "deny", "")
    typed = ""

// Secrets the Dood asked for, saved to a file on a computer or as a connector's access token.
component SecretCard
  props
    ask: SecretAsk
    at: number
    agentId: string
    name: string
    here: bool
    team: string
  inject
    giveSecrets: action
    declineSecrets: action
    secretBusy: bool
    secretError: string
  // What is typed, in the order of the fields, and which are shown as typed.
  state values: string[] = []
  state shown: string[] = []
  state problem = ""
  derive one = ask.fields.length == 1
  view
    column gap=12 padding=14 border-radius=16 class=Card role="listitem" testId=`secret-${at}`
      row gap=10 align-items="flex-start"
        image "symbol:icon.key" color="ink.muted" aria-hidden=true margin-top=2 flex-shrink=0
        column flex=1 min-width=0 gap=2
          text font-size="0.875rem" testId=`secret-title-${at}`
            text name font-weight=500
            if ask.subagent != ""
              text "’s sub-agent "
              text ask.subagent font-weight=500
            text (ask.kind == "connector" ? " asks for the access token of " : one ? " asks for a secret" : ` asks for ${ask.fields.length} secrets`)
            if ask.kind == "connector"
              text ask.name font-weight=500
          if ask.purpose != ""
            text `“${ask.purpose}”` font-size="0.875rem" color="ink.muted" testId=`secret-purpose-${at}`
          text font-size="0.75rem" color="ink.muted" margin-top=4 overflow-wrap="break-word"
            if ask.kind == "connector"
              text "Kept with the connector at "
              text ask.place font-family="Geist Mono"
              text " and sent only there. "
            else
              text "Saved to "
              text ask.name font-family="Geist Mono" color="ink"
              text " on "
              text ask.place font-family="Geist Mono"
              text ". "
            text `What you type is not put in the chat or shown to ${name}.`
          if not here
            AskedIn(agentId=agentId, chatId=ask.chatId, lead=(ask.subagent == "" ? "Asked in " : "From the sub-agent "), title=(ask.subagent == "" ? "another chat" : ask.subagent))
          if ask.subagent != ""
            text `Asked while working on: “${ask.task}”. Fill it in only if you expected it.` font-size="0.75rem" color="ink.muted"
      column gap=12
        for f, i in ask.fields key=f.name
          column gap=4 min-width=0
            text (ask.kind == "connector" ? "Access token" : f.name) class=FieldLabel font-family="Geist Mono" font-size="0.75rem"
            if f.description != ""
              text f.description font-size="0.75rem" color="ink.muted" testId=`secret-field-note-${f.name}`
            row position="relative" align-items="center"
              input type=(shown.includes(f.name) ? "text" : "password") autocomplete="off" autocapitalize="none" value=valueAt(values, i) input=edit(i)
                disabled=secretBusy aria-label=f.name class=Field flex=1 min-width=0 padding="0 40px 0 10px" font-family="Geist Mono" testId=`secret-field-${f.name}`
              button press=toggleShown(f.name) aria-label=`${shown.includes(f.name) ? "Hide" : "Show"} ${f.name}` aria-pressed=shown.includes(f.name) disabled=secretBusy
                position="absolute" right=4 class=QuietButton color="ink.muted" padding="0 6px" testId=`secret-show-${f.name}`
                image (shown.includes(f.name) ? "symbol:icon.eye-slash" : "symbol:icon.eye") aria-hidden=true
      if problem != "" or secretError != ""
        text (problem != "" ? problem : secretError) role="alert" font-size="0.875rem" color="danger" testId=`secret-error-${at}`
      row gap=8 flex-wrap="wrap" align-items="center"
        button press=save disabled=secretBusy class=PrimaryButton testId=`secret-save-${at}`
          text (secretBusy ? "Saving…" : one ? "Save secret" : "Save secrets")
        button press=notNow disabled=secretBusy class=QuietButton min-height="2.125rem" testId=`secret-decline-${at}`
          text "Not now"
        if team != ""
          text `Anyone in ${team} can answer` margin-left="auto" font-size="0.75rem" color="ink.muted"
  action edit(i: number, v: string)
    problem = ""
    values = range(ask.fields.length).map(j => j == i ? v : valueAt(values, j))
  action toggleShown(field: string)
    shown = shown.includes(field) ? shown.filter(s => s != field) : shown.concat([field])
  // Why a value cannot be saved, the first one's: as the React app's `problemWith`.
  action save
    problem = firstProblem(ask.fields, values)
    if firstProblem(ask.fields, values) == ""
      giveSecrets(ask.id, ask.fields.map(f => f.name), range(ask.fields.length).map(j => valueAt(values, j)))
      values = []
  action notNow
    declineSecrets(ask.id)

fn valueAt(values: string[], i: number): string = match values.at(i) { case some(v) => v, case none => "" }
fn firstProblem(fields: SecretField[], values: string[]): string = match range(fields.length).map(j => match fields.at(j) { case some(f) => problemWith(f.name, valueAt(values, j)), case none => "" }).filter(w => w != "").at(0) {
  case some(w) => w,
  case none => ""
}
fn problemWith(name: string, value: string): string = value == "" ? `Type a value for ${name}.` : (value.length > 16384 ? `${name} is too long to save.` : "")

// A login the Dood asked for, to sign in on a site with: kept by the workspace, typed only there.
component LoginCard
  props
    ask: SecretAsk
    at: number
    agentId: string
    name: string
    here: bool
    team: string
  inject
    giveLogin: action
    declineSecrets: action
    secretBusy: bool
    secretError: string
  state username = ""
  state password = ""
  view
    column gap=12 padding=14 border-radius=16 class=Card role="listitem" testId=`login-${at}`
      row gap=10 align-items="flex-start"
        image "symbol:icon.key" color="ink.muted" aria-hidden=true margin-top=2 flex-shrink=0
        column flex=1 min-width=0 gap=2
          text font-size="0.875rem" overflow-wrap="break-word"
            text name font-weight=500
            if ask.subagent != ""
              text "’s sub-agent "
              text ask.subagent font-weight=500
            text " needs a login for "
            text ask.name font-weight=500
          if ask.purpose != ""
            text `“${ask.purpose}”` font-size="0.875rem" color="ink.muted"
          text `Kept encrypted by Do Computer. ${name} can sign in with it on ${ask.name} and cannot read it.` font-size="0.75rem" color="ink.muted" margin-top=4
          if not here
            AskedIn(agentId=agentId, chatId=ask.chatId, lead=(ask.subagent == "" ? "Asked in " : "From the sub-agent "), title=(ask.subagent == "" ? "another chat" : ask.subagent))
      column gap=4
        text "Username or email" class=FieldLabel
        input value=username input=editUsername autocomplete="off" autocapitalize="none" disabled=secretBusy aria-label="Username or email" class=Field testId=`login-username-${at}`
      column gap=4
        text "Password" class=FieldLabel
        input type="password" value=password input=editPassword autocomplete="off" disabled=secretBusy aria-label="Password" class=Field testId=`login-password-${at}`
      if secretError != ""
        text secretError role="alert" font-size="0.875rem" color="danger"
      row gap=8 flex-wrap="wrap" align-items="center"
        button press=save disabled=secretBusy class=PrimaryButton testId=`login-save-${at}`
          text (secretBusy ? "Saving…" : "Save")
        button press=notNow disabled=secretBusy class=QuietButton min-height="2.125rem"
          text "Not now"
        if team != ""
          text `Anyone in ${team} can answer` margin-left="auto" font-size="0.75rem" color="ink.muted"
  action editUsername(v: string)
    username = v
  action editPassword(v: string)
    password = v
  action save
    giveLogin(ask.id, ask.name, username, password)
    password = ""
  action notNow
    declineSecrets(ask.id)

// A connector the Dood added that someone has to sign in to before it can be used.
component SignInCard
  props
    connector: SignInAsk
    at: number
    name: string
  inject
    signInTo: action
    notNowSignIn: action
    signInBusy: bool
    signInError: string
  view
    column gap=10 padding=14 border-radius=16 class=Card role="listitem" testId=`sign-in-${at}`
      row gap=10 align-items="flex-start"
        image "symbol:icon.plugs-connected" color="ink.muted" aria-hidden=true margin-top=2 flex-shrink=0
        column flex=1 min-width=0 gap=2
          text font-size="0.875rem"
            text name font-weight=500
            text " added the connector "
            text connector.name font-weight=500
            text ", which needs you to sign in"
          text font-size="0.75rem" color="ink.muted" overflow-wrap="break-word"
            text "You sign in at "
            text connector.host font-family="Geist Mono"
            text ` and come back here. ${name} never sees your password.`
      if signInError != ""
        text signInError role="alert" font-size="0.875rem" color="danger"
      row gap=8
        button press=signInTo(connector.id) disabled=signInBusy class=PrimaryButton
          text "Sign in"
        button press=notNowSignIn(connector.id) disabled=signInBusy class=QuietButton min-height="2.125rem"
          text "Not now"

// A computer the Dood asks to use, with the answer for whoever it belongs to.
component ComputerCard
  props
    ask: ComputerAsk
    at: number
    name: string
  inject
    answerComputer: action
    computerBusy: bool
    computerError: string
    // The open Dood's workspace and its team's name: a computer of that team is anyone's in it to answer for.
    chatWorkspaceId: string
    chatTeam: string
  derive team = ask.workspaceId == chatWorkspaceId ? chatTeam : ""
  view
    column gap=10 padding=14 border-radius=16 class=Card role="listitem" testId=`computer-ask-${at}`
      row gap=10 align-items="flex-start"
        image "symbol:icon.desktop" color="ink.muted" aria-hidden=true margin-top=2 flex-shrink=0
        column flex=1 min-width=0 gap=2
          text font-size="0.875rem"
            text name font-weight=500
            text " asks to use the computer "
            text ask.computer font-family="Geist Mono" font-weight=500
          if ask.reason != ""
            text `“${ask.reason}”` font-size="0.875rem" color="ink.muted"
      if computerError != ""
        text computerError role="alert" font-size="0.875rem" color="danger"
      if ask.canAnswer
        row gap=8 flex-wrap="wrap" align-items="center"
          button press=answerComputer(ask.id, true) disabled=computerBusy class=PrimaryButton testId=`computer-allow-${at}`
            text "Allow"
          button press=answerComputer(ask.id, false) disabled=computerBusy class=QuietButton min-height="2.125rem"
            text "Don’t allow"
          text (team != "" ? `Anyone in ${team} can answer` : ask.readOnly ? "It will be able to read files there" : "It will be able to run commands and change files there")
            margin-left="auto" font-size="0.75rem" color="ink.muted"
      else
        text `Waiting for ${team != "" ? team : ask.pairedBy} to answer.` font-size="0.75rem" color="ink.muted"
