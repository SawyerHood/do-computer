// Keep simple prose in Exact. A rich message stays in one DOM tree so selection crosses blocks.
component MessageText
  props
    text: string
    streaming: bool
    files: string
    message: action
  derive rich = text.includes("\n") or text.includes("[") or text.includes("<") or text.includes("```") or text.includes("~~~") or text.includes("://") or text.includes("www.") or text.includes("@")
  view
    if rich
      do-markdown text=text streaming=streaming.toString() files=files message=message min-width=0 max-width="100%" align-self="stretch" aria-label="Message text"
    else
      text text markup="markdown" user-select="text" overflow-wrap="anywhere" max-width="100%"
