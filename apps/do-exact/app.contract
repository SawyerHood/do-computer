// Do Computer, as an Exact app. This file is the root: the routes, which file holds each area's
// members (its resources, mutations, state and actions), what every screen can inject, the
// navigation, and which screen draws each route. Everything else is in views/<area>.contract,
// and the data the areas ask for in data/<area>.ts, which app.ts gathers. PORTING.md says how
// to add an area.
use Page from "./views/shapes.contract"
use SignIn from "./views/sign-in.contract"
use Sidebar from "./views/shell.contract"
use ChatScreen from "./views/chat.contract"
use LibraryScreen from "./views/library.contract"
use AutomationsScreen from "./views/automations.contract"
use SkillsScreen from "./views/skills.contract"
use ConnectorsScreen from "./views/connectors.contract"
use ComputersScreen from "./views/computers.contract"
use PermissionsScreen from "./views/permissions.contract"
use ProfileScreen, MemoryScreen, ModelScreen, UsageScreen from "./views/profile.contract"
use DoodSettingsScreen from "./views/dood-settings.contract"
use WorkspaceHomeScreen from "./views/workspace.contract"
use PeopleScreen from "./views/people.contract"
use WorkspaceSettingsScreen from "./views/workspace-settings.contract"

// The React app's type: Geist (assets/fonts, from vercel/geist-font, OFL).
font "Geist" = "assets/fonts/Geist-Variable.ttf"
font "Geist Mono" = "assets/fonts/GeistMono-Variable.ttf"

// The React app's addresses (apps/web/src/routes/_app.*). A Dood's pages are under it, so a
// phone's Back from one goes to its chat, and from the chat to the list.
routes nav
  doods "/"
    dood "/a/:agentId"
      chat "/a/:agentId/c/:chatId"
      library "/a/:agentId/library"
      automations "/a/:agentId/automations"
      skills "/a/:agentId/skills"
      connectors "/a/:agentId/connectors"
      computers "/a/:agentId/computers"
      permissions "/a/:agentId/permissions"
      profile "/a/:agentId/profile"
      settings "/a/:agentId/settings"
      // --- settings: a Dood's other sections ---
      memory "/a/:agentId/memory"
      model "/a/:agentId/model"
      usage "/a/:agentId/usage"
    workspace "/w/:workspaceId"
      people "/w/:workspaceId/people"
      workspaceSettings "/w/:workspaceId/settings"

// A segment of a path, "" past its end.
fn segment(url: string, at: number): string = match url.split("?").at(0) {
  case some(p) => match p.split("/").at(at) { case some(s) => s, case none => "" },
  case none => ""
}
// The page a location's other pages hang from: a Dood's chat or a workspace's page, else the list.
fn baseOf(url: string): string = url.startsWith("/a/") ? `/a/${segment(url, 2)}` : url.startsWith("/w/") ? `/w/${segment(url, 2)}` : "/"

component App
  members "./views/sign-in.contract"
  members "./views/shell.contract"
  members "./views/chat.contract"
  // --- settings ---
  members "./views/profile.contract"
  members "./views/permissions.contract"
  // A new area adds its members line here, in its own place, in the order of the routes.

  // What any screen may `inject` instead of taking it as a prop.
  provide
    session
    doodList
    workspaceList
    now
    utcOffset = time.utcOffset
    wide
    hatchError
    hatching = pending(hatched)
    panelOpen
    hatch
    signOut
    togglePanel
    back
    // --- settings: a Dood's ---
    doodSetup
    setupOurs
    shownForm
    doodFormDirty
    formOver
    doodSaving = pending(doodSaved)
    doodSaveError
    doodSavedOk
    doodModelList
    doodComputers
    doodComputersOurs
    doodVoice
    voicePicked
    voiceError
    voiceBusy = pending(voiceSet)
    moveTarget
    moveError
    moving = pending(doodMoved)
    deleteOpen
    deleteTyped
    deleteComputers
    deleteError
    deleting = pending(doodDeleted)
    freshError
    freshOk
    freshBusy = pending(freshStarted)
    doodUsage
    usageLoading = pending(doodUsage)
    editDood
    rollLook
    saveDoodForm
    pickVoice
    chooseMove
    move
    openDelete
    cancelDelete
    typeDelete
    toggleDeleteComputers
    deleteDoodNow
    askFresh
    startFreshNow
    approvals
    ruling = pending(ruled)
    ruleFor
    ruleTo
    ruleError
    setRule

  // The Dood whose page is open (the deepest one in the stack), and the chat a `/c/` page names.
  derive openAgentId = match stack(nav).filter(e => e.params.agentId != "").at(-1) { case some(e) => e.params.agentId, case none => "" }
  derive chatEntryId = match stack(nav).filter(e => e.name == "chat").at(-1) { case some(e) => e.params.chatId, case none => "" }
  // The route on top, for tests and for what reads which page is showing.
  derive onRoute = top(nav).name

  // Every link, and the browser's Forward and a typed address, come here. The stack is always
  // the list, then the page a location hangs from (a Dood's chat, a workspace's page), then the
  // location: so a phone's Back goes up one, a wide window shows the location beside the list,
  // and a Dood's chat that is already open is kept, with its scroll, under its other pages. One
  // of a Dood's pages in place of another replaces it, so the browser's Forward finds it again.
  action follow(url: string)
    let base = baseOf(url)
    let home = go(nav, "/")
    let held = stack(nav).filter(e => e.url == base).length > 0
    let under = base == "/" ? home : (held ? go(nav, base) : push(home, base))
    let sibling = base != "/" and url != base and top(nav).url != base and baseOf(top(nav).url) == base
    nav = sibling ? replace(nav, url) : (base == "/" or url == base or top(under).url == url ? under : push(under, url))
  action back
    nav = back(nav)

  view
    main navigationKey=`${top(nav).id}` navigationBack="back" navigate=follow interactive-widget="resizes-content"
      width="100%" height="100%" font-family="Geist" color="ink" testId="app"
      if not session.signedIn
        if pending(session)
          column position="absolute" inset=0 justify-content="center" align-items="center" background-color="frame"
            progress aria-label="Loading" testId="session-loading"
        else
          SignIn(email=email, password=password, name=name, joining=joining, error=signError, busy=pending(signed), canSign=canSign, editEmail=editEmail, editPassword=editPassword, editName=editName, toggleJoining=toggleJoining, sign=sign)
      else
        for e in stack(nav) key=e.id
          // --- shell ---
          if e.name == "doods"
            Sidebar(key=`${e.id}`, current=openAgentId)
          // --- chat ---
          if e.name == "dood" or e.name == "chat"
            ChatScreen(page=Page(key=`${e.id}`, agentId=e.params.agentId, workspaceId=""), route=e.name, chat=chat, ours=ours, loading=(pending(opened) or pending(chat)), draft=draft, sayError=sayError, sending=pending(said), editDraft=editDraft, say=say, heal=heal)
          // --- library ---
          if e.name == "library"
            LibraryScreen(page=Page(key=`${e.id}`, agentId=e.params.agentId, workspaceId=""))
          // --- automations ---
          if e.name == "automations"
            AutomationsScreen(page=Page(key=`${e.id}`, agentId=e.params.agentId, workspaceId=""))
          // --- skills ---
          if e.name == "skills"
            SkillsScreen(page=Page(key=`${e.id}`, agentId=e.params.agentId, workspaceId=""))
          // --- connectors ---
          if e.name == "connectors"
            ConnectorsScreen(page=Page(key=`${e.id}`, agentId=e.params.agentId, workspaceId=""))
          // --- computers ---
          if e.name == "computers"
            ComputersScreen(page=Page(key=`${e.id}`, agentId=e.params.agentId, workspaceId=""))
          // --- permissions ---
          if e.name == "permissions"
            PermissionsScreen(page=Page(key=`${e.id}`, agentId=e.params.agentId, workspaceId=""))
          // --- profile ---
          if e.name == "profile"
            ProfileScreen(page=Page(key=`${e.id}`, agentId=e.params.agentId, workspaceId=""), route="profile")
          // --- dood settings ---
          if e.name == "settings"
            DoodSettingsScreen(page=Page(key=`${e.id}`, agentId=e.params.agentId, workspaceId=""))
          // --- settings: a Dood's other sections ---
          if e.name == "memory"
            MemoryScreen(page=Page(key=`${e.id}`, agentId=e.params.agentId, workspaceId=""))
          if e.name == "model"
            ModelScreen(page=Page(key=`${e.id}`, agentId=e.params.agentId, workspaceId=""))
          if e.name == "usage"
            UsageScreen(page=Page(key=`${e.id}`, agentId=e.params.agentId, workspaceId=""))
          // --- workspace ---
          if e.name == "workspace"
            WorkspaceHomeScreen(page=Page(key=`${e.id}`, agentId="", workspaceId=e.params.workspaceId))
          // --- people ---
          if e.name == "people"
            PeopleScreen(page=Page(key=`${e.id}`, agentId="", workspaceId=e.params.workspaceId))
          // --- workspace settings ---
          if e.name == "workspaceSettings"
            WorkspaceSettingsScreen(page=Page(key=`${e.id}`, agentId="", workspaceId=e.params.workspaceId))
