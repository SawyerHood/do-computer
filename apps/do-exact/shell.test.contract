// The shell: the sidebar beside the page on a wide window, a stack on a phone, a Dood's pages
// reached from its pill, Back and Forward, and a page that is there after a reload.
// Every test starts signed out, with empty storage, on a server the whole run shares: it makes
// an account of its own first, with the same six lines and an address no other test uses.

test "a wide window shows the sidebar beside a Dood's chat, and its panel beside that"
  size 1280x800
  tap "sign-toggle"
  type "sign-name" "Ada"
  type "sign-email" "shell-1@example.com"
  type "sign-password" "correct horse"
  tap "sign-submit"
  clock data
  expect state onRoute == "doods"
  expect tree has "first-dood"
  tap "first-dood"
  clock data
  clock settle
  clock data
  expect state onRoute == "dood"
  expect tree has "sidebar"
  expect text "title-dood" == "New Dood"
  expect tree has "panel-toggle-dood"
  expect tree missing "back-dood"
  tap "panel-toggle-dood"
  expect tree has "dood-panel"
  expect text "panel-status" == "About to hatch"
  tap "panel-toggle-dood"
  expect tree missing "dood-panel"

test "a phone shows the list, a Dood's chat over it, and Back returns to the list"
  size 390x844
  tap "sign-toggle"
  type "sign-name" "Ada"
  type "sign-email" "shell-2@example.com"
  type "sign-password" "correct horse"
  tap "sign-submit"
  clock data
  expect state onRoute == "doods"
  tap "new-dood"
  clock data
  clock settle
  clock data
  expect state onRoute == "dood"
  expect tree has "back-dood"
  expect tree missing "panel-toggle-dood"
  tap "back-dood"
  clock settle
  expect state onRoute == "doods"
  tap "New Dood"
  clock settle
  clock data
  expect state onRoute == "dood"
  back
  clock settle
  expect state onRoute == "doods"

test "a window narrowed to a phone's keeps the Dood open, with the way back to the list"
  size 1280x800
  tap "sign-toggle"
  type "sign-name" "Ada"
  type "sign-email" "shell-3@example.com"
  type "sign-password" "correct horse"
  tap "sign-submit"
  clock data
  tap "new-dood"
  clock data
  clock settle
  clock data
  expect tree missing "back-dood"
  resize 390x844
  clock settle
  expect state onRoute == "dood"
  expect tree has "back-dood"
  expect tree missing "panel-toggle-dood"

test "a Dood's pages open from its pill, Back returns to its chat, and a page survives a reload"
  size 1280x800
  tap "sign-toggle"
  type "sign-name" "Ada"
  type "sign-email" "shell-4@example.com"
  type "sign-password" "correct horse"
  tap "sign-submit"
  clock data
  tap "new-dood"
  clock data
  clock settle
  clock data
  tap "pages-dood"
  tap "go-library-dood"
  clock settle
  expect state onRoute == "library"
  expect text "heading-library" == "Library"
  expect text "title-library" == "New Dood"
  tap "pages-library"
  tap "go-skills-library"
  clock settle
  expect state onRoute == "skills"
  expect text "heading-skills" == "Skills"
  back
  clock settle
  expect state onRoute == "dood"
  tap "pages-dood"
  tap "go-skills-dood"
  clock settle
  expect state onRoute == "skills"
  reload
  clock data
  clock settle
  expect state onRoute == "skills"
  expect text "heading-skills" == "Skills"
  expect text "title-skills" == "New Dood"
  tap "pages-skills"
  tap "go-chat-skills"
  clock settle
  clock data
  expect state onRoute == "dood"
  expect tree has "composer"

test "a workspace's settings open from its menu in the sidebar"
  size 1280x800
  tap "sign-toggle"
  type "sign-name" "Ada"
  type "sign-email" "shell-5@example.com"
  type "sign-password" "correct horse"
  tap "sign-submit"
  clock data
  // The sidebar starts shut to its faces, as the React app's does.
  type "sidebar-resize" key "End"
  tap "workspace-menu-personal"
  tap "workspace-settings-personal"
  clock settle
  expect state onRoute == "workspaceSettings"
  expect text "heading-workspaceComputers" == "Computers"

test "the sidebar's edge is dragged wider and narrower between its bounds, moved by the arrow keys, and kept over a reload"
  size 1280x800
  tap "sign-toggle"
  type "sign-name" "Ada"
  type "sign-email" "shell-resize@example.com"
  type "sign-password" "correct horse"
  tap "sign-submit"
  clock data
  expect state sidebarShut == true
  type "sidebar-resize" key "End"
  expect state sidebarWidth == 288
  expect tree has "sidebar-resize"
  tap "sidebar-resize" drag 60 0 mouse
  expect state sidebarWidth == 348
  expect state sidebarDragging == false
  tap "sidebar-resize" drag -330 0 mouse
  expect state sidebarWidth == 208
  tap "sidebar-resize" drag 900 0 mouse
  expect state sidebarWidth == 448
  // After a drag that ended away from the edge, the next one still follows the pointer.
  tap "sidebar-resize" drag -48 0 mouse
  expect state sidebarWidth == 400
  tap "sidebar-resize" drag 48 0 mouse
  type "sidebar-resize" key "ArrowLeft"
  expect state sidebarWidth == 432
  expect state sidebarShut == false
  reload
  clock data
  expect state sidebarWidth == 432
  tap "sidebar-resize" dblclick
  expect state sidebarWidth == 288

test "a phone has no edge to drag"
  size 390x844
  tap "sign-toggle"
  type "sign-name" "Ada"
  type "sign-email" "shell-resize-2@example.com"
  type "sign-password" "correct horse"
  tap "sign-submit"
  clock data
  expect tree has "sidebar"
  expect tree missing "sidebar-resize"

test "the sidebar shuts to a column of faces and opens again, by the edge, the keys and a double press, and stays shut over a reload"
  size 1280x800
  tap "sign-toggle"
  type "sign-name" "Ada"
  type "sign-email" "shell-rail@example.com"
  type "sign-password" "correct horse"
  tap "sign-submit"
  clock data
  tap "first-dood"
  clock data
  clock settle
  clock data
  expect tree missing "account-name"
  tap "sidebar-resize" dblclick
  expect state sidebarShut == false
  expect tree has "account-name"
  // Dragged in past half way to its narrowest, it is shut.
  tap "sidebar-resize" drag -200 0 mouse
  expect state sidebarShut == true
  expect state sidebarWidth == 208
  expect tree missing "account-name"
  expect tree missing "new-team"
  expect tree has "new-dood"
  expect state onRoute == "dood"
  reload
  clock data
  expect state sidebarShut == true
  // Pulled out again from there.
  tap "sidebar-resize" drag 240 0 mouse
  expect state sidebarShut == false
  expect state sidebarWidth == 300
  expect tree has "account-name"
  type "sidebar-resize" key "Home"
  expect state sidebarShut == true
  type "sidebar-resize" key "ArrowRight"
  expect state sidebarShut == false
  expect state sidebarWidth == 300
  type "sidebar-resize" key "Home"
  tap "sidebar-resize" dblclick
  expect state sidebarShut == false
