#!/usr/bin/env bash
# Runs an Exact verb for this app with the tools on PATH: ./x test web, ./x agent web …, ./x verify.
# The server and interactive page use the checkout's slot, and wait their turn on its lock.
# Verify's concurrent page drives use a small slot-specific range instead of one fixed port.
set -euo pipefail
cd "$(dirname "$0")"
export PATH="$HOME/.bun-1.4.2/bin:$HOME/.nvm/versions/node/v24.18.0/bin:$HOME/.cargo/bin:$PATH"
# Nothing about this project is sent to Expo.
export EXACT_FEEDBACK=0
# A checkout's slot (the number in .slot, else 0) moves both ports, so checkouts with different
# slots run at once; the lock is per slot.
slot="${DCX_SLOT:-$(cat .slot 2>/dev/null || echo 0)}"
export EXACT_PORT="${EXACT_PORT:-$((8766 + slot))}"
export API_BASE_URL="${API_BASE_URL:-http://127.0.0.1:$((3911 + slot))}"
# Its sockets: the same address, ws: for http: and wss: for https:.
export API_SOCKET_URL="${API_SOCKET_URL:-${API_BASE_URL/#http/ws}}"
if [ -z "${CHROME:-}" ]; then
  CHROME="$(ls -d "$HOME"/.cache/ms-playwright/chromium-*/chrome-linux64/chrome 2>/dev/null | sort -V | tail -1 || true)"
  [ -n "$CHROME" ] && export CHROME
fi
case "${1:-}" in
  verify)
    # Exact launches the initial phone and desktop checks together. A fixed EXACT_PORT makes
    # one fail with EADDRINUSE. Keep the API on its slot, but let the page drives pick a free
    # port from this slot's range; the local test server must trust each of those origins.
    export PORT_LO="${PORT_LO:-$((18766 + slot * 10))}"
    export PORT_HI="${PORT_HI:-$((PORT_LO + 9))}"
    origins="http://127.0.0.1:$EXACT_PORT"
    for ((port=PORT_LO; port<=PORT_HI; port++)); do origins+=",http://127.0.0.1:$port"; done
    export DC_CLIENT_ORIGINS="${DC_CLIENT_ORIGINS:-$origins}"
    unset EXACT_PORT
    exec flock "/tmp/do-exact-ports-$slot.lock" bun exact.mjs "$@"
    ;;
  test|agent|web) exec flock "/tmp/do-exact-ports-$slot.lock" bun exact.mjs "$@" ;;
  *) exec bun exact.mjs "$@" ;;
esac
