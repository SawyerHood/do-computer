// Run by `test` or `verify` against Do Computer's own server (server.ts), empty, for the whole run.
// It has no model key, so the Dood answers with the built-in echo model.
test "an account is made, a Dood is hatched, and what is said to it is answered in its chat"
  expect tree has "sign-title"
  expect disabled "sign-submit"
  type "sign-email" "ada@example.com"
  type "sign-password" "wrong horse"
  tap "sign-submit"
  clock data
  expect tree has "sign-error"
  tap "sign-toggle"
  type "sign-name" "Ada"
  type "sign-password" "correct horse"
  tap "sign-submit"
  clock data
  expect state session.signedIn == true
  expect state session.name == "Ada"
  expect tree has "first-dood"
  tap "first-dood"
  clock data
  expect state doods.length == 1
  tap "New Dood"
  clock settle
  clock data
  expect tree has "composer"
  expect disabled "send"
  type "composer" "hello there"
  tap "send"
  clock data
  expect text "composer" == ""
  clock +3000 real
  expect state chat.messages.0 .role == "user"
  expect state chat.messages.0 .blocks.0 .text == "hello there"
  expect state chat.messages.1 .role == "assistant"
  expect state chat.busy == false
  back
  clock settle
  reload
  clock data
  expect state session.signedIn == true
  expect state doods.length == 1
  tap "New Dood"
  clock settle
  clock data
  expect state chat.messages.length == 2
  expect state chat.messages.0 .blocks.0 .text == "hello there"
