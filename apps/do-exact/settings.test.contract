  clock data
  clock settle
  tap "settings-go-memory-profile"
  clock data
  clock settle
  clock data
  tap "memory-fresh-start"
  clock settle
  expect tree has "memory-fresh-confirm"
  tap "memory-fresh-confirm-no"
  clock settle
  expect tree missing "memory-fresh-done"
