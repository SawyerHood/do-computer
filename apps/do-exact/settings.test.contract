test "the theme is chosen, set on the app and kept"
  size 1280x800
  tap "sign-toggle"
  type "sign-name" "Ada"
  type "sign-email" "settings-11@example.com"
  type "sign-password" "correct horse"
  tap "sign-submit"
  clock data
  tap "account"
  tap "account-settings"
  clock data
  clock settle
  expect state theme == "system"
  tap "theme-dark"
  expect state theme == "dark"
  reload
  clock data
  clock settle
  expect state theme == "dark"
  tap "theme-system"
  expect state theme == "system"

test "a workspace is signed in to a provider with a key, which is not kept here, and signed out after asking"
  size 1280x800
  tap "sign-toggle"
  type "sign-name" "Ada"
  type "sign-email" "settings-12@example.com"
  type "sign-password" "correct horse"
  tap "sign-submit"
  clock data
  tap "new-dood"
  clock data
  clock settle
  clock data
  tap "pages-dood"
  tap "go-profile-dood"
  clock data
  clock settle
  tap "settings-go-model-profile"
  clock data
  clock settle
  tap "model-workspace-models"
  clock data
  clock settle
  clock data
  expect state onRoute == "workspaceModels"
  expect text "models-own-words" == "A built-in echo model that repeats what it is told: this deployment has no model key and is signed in to nothing."
  tap "provider-key-openai"
  clock data
  clock settle
  clock +1000
  clock data
  expect text "model-sign-in-title" == "OpenAI API key"
  type "model-sign-in-typed" "sk-test-not-a-real-key"
  tap "model-sign-in-submit"
  clock data
  clock +1000
  clock data
  clock settle
  expect state loginTyped == ""
  expect tree has "provider-signed-in-openai"
  tap "provider-sign-out-openai"
  clock settle
  tap "provider-sign-out-confirm-yes"
  clock data
  clock settle
  expect tree missing "provider-signed-in-openai"

test "a login is added, changed, given a new password and removed, and a card added and removed"
  size 1280x800
  tap "sign-toggle"
  type "sign-name" "Ada"
  type "sign-email" "settings-13@example.com"
  type "sign-password" "correct horse"
  tap "sign-submit"
  clock data
  tap "new-dood"
  clock data
  clock settle
  clock data
  tap "pages-dood"
  tap "go-profile-dood"
  clock data
  clock settle
  tap "settings-go-model-profile"
  clock data
  clock settle
  tap "model-workspace-models"
  clock data
  clock settle
  tap "settings-go-passwords-workspaceModels"
  clock data
  clock settle
  clock data
  expect state onRoute == "passwords"
  expect tree has "logins-empty"
  tap "login-add"
  clock settle
  type "login-name" "GitHub"
  type "login-username" "ada@example.com"
  type "login-password" "hunter2"
  tap "login-save"
  clock data
  expect text "login-error" == "Add the site it is used on."
  type "login-site" "not a site"
  tap "login-save"
  clock data
  expect text "login-error" == "“not a site” is not a site. Type one like github.com."
  type "login-site" "https://github.com/login"
  tap "login-save"
  clock data
  clock settle
  clock data
  expect state lPassword == ""
  expect state savedLogins.logins.length == 1
  expect text "login-about-0" == "ada@example.com · github.com"
  tap "login-menu-0"
  tap "login-change-0"
  clock settle
  type "login-name" "GitHub work"
  tap "login-save"
  clock data
  clock settle
  clock data
  expect text "login-name-0" == "GitHub work"
  tap "login-menu-0"
  tap "login-password-0"
  clock settle
  expect tree missing "login-name"
  type "login-password" "correct battery"
  tap "login-save"
  clock data
  clock settle
  clock data
  expect state lPassword == ""
  tap "login-menu-0"
  tap "login-remove-0"
  clock settle
  tap "login-remove-confirm-yes"
  clock data
  clock settle
  expect tree has "logins-empty"
  tap "card-add"
  clock settle
  type "card-number" "4242 4242 4242 4241"
  type "card-expires" "08/30"
  tap "card-save"
  clock data
  expect text "card-error" == "That is not a card number. Check it against the card."
  type "card-number" "4242424242424242"
  expect text "card-number" == "4242 4242 4242 4242"
  tap "card-save"
  clock data
  clock settle
  clock data
  expect state cNumber == ""
  expect text "card-name-0" == "Visa ending 4242"
  tap "card-remove-0"
  clock settle
  tap "card-remove-confirm-yes"
  clock data
  clock settle
  expect tree has "cards-empty"

test "the notifications page says how this browser stands and offers to turn them on"
  size 1280x800
  tap "sign-toggle"
  type "sign-name" "Ada"
  type "sign-email" "settings-14@example.com"
  type "sign-password" "correct horse"
  tap "sign-submit"
  clock data
  tap "account"
  tap "account-settings"
  clock data
  clock settle
  tap "settings-go-notifications-account"
  clock data
  clock settle
  clock data
  clock +500 real
  expect state onRoute == "notifications"
  expect text "notifications-state" == "Off for this browser."
  expect tree has "notifications-on"
