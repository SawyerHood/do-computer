// The settings: a Dood's (profile, memory, model and computers, usage, permissions), the
// person's own (general, the lists of Doods and workspaces), a workspace's models and passwords,
// and the frame they are drawn in, wide and on a phone. Against Do Computer's own server
// (server.ts), empty for each run, with the echo model and saved logins and cards turned on.
// Every test starts signed out, with empty storage, on a server the whole run shares: it makes
// an account of its own first, with the same six lines and an address no other test uses.

test "a Dood's profile is saved: its name, tagline, colour and personality, and they are there after a reload"
  size 1280x800
  tap "sign-toggle"
  type "sign-name" "Ada"
  type "sign-email" "settings-1@example.com"
  type "sign-password" "correct horse"
  tap "sign-submit"
  clock data
  tap "new-dood"
  clock data
  clock settle
  clock data
  tap "pages-dood"
  tap "go-profile-dood"
  clock data
  clock settle
  clock data
  expect state onRoute == "profile"
  expect text "heading-profile" == "Profile"
  expect text "settings-name-profile" == "New Dood"
  expect disabled "dood-save"
  type "profile-name" "Pico"
  type "profile-tagline" "Plans weekends"
  tap "profile-color-moss"
  type "profile-soul" "You are cheerful."
  expect state doodFormDirty == true
  tap "dood-save"
  clock data
  clock settle
  clock data
  expect state doodFormDirty == false
  expect text "dood-saved" == "Saved"
  expect state doods.doods.0 .name == "Pico"
  expect state doodSetup.form.color == "moss"
  expect state doodSetup.form.soul == "You are cheerful."
  reload
  clock data
  clock settle
  clock data
  expect state onRoute == "profile"
  expect text "profile-name" == "Pico"
  expect text "profile-tagline" == "Plans weekends"
  expect text "settings-name-profile" == "Pico"

test "a new look is rolled, kept only once saved"
  size 1280x800
  tap "sign-toggle"
  type "sign-name" "Ada"
  type "sign-email" "settings-2@example.com"
  type "sign-password" "correct horse"
  tap "sign-submit"
  clock data
  tap "new-dood"
  clock data
  clock settle
  clock data
  tap "pages-dood"
  tap "go-profile-dood"
  clock data
  clock settle
  clock data
  expect state doodSetup.form.seed == ""
  tap "profile-roll"
  expect state doodFormDirty == true
  expect state doodSetup.form.seed == ""
  tap "dood-save"
  clock data
  clock settle
  clock data
  expect state doodFormDirty == false
  expect state doodSaved.ok == true

test "memory and what the Dood knows of the person are saved, counted against their limits"
  size 1280x800
  tap "sign-toggle"
  type "sign-name" "Ada"
  type "sign-email" "settings-3@example.com"
  type "sign-password" "correct horse"
  tap "sign-submit"
  clock data
  tap "new-dood"
  clock data
  clock settle
  clock data
  tap "pages-dood"
  tap "go-profile-dood"
  clock data
  clock settle
  tap "settings-go-memory-profile"
  clock data
  clock settle
  clock data
  expect state onRoute == "memory"
  expect text "heading-memory" == "Memory"
  type "memory-text" "Likes trains."
  expect text "memory-text-count" == "13 / 6000"
  type "memory-about" "Ada lives in Lisbon."
  tap "dood-save"
  clock data
  clock settle
  clock data
  expect text "dood-saved" == "Saved"
  expect state doodSetup.form.memory == "Likes trains."
  expect state doodSetup.form.user == "Ada lives in Lisbon."

test "what is typed on one of a Dood's sections is kept while another is open, and saved from there"
