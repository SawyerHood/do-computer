  tap "go-settings-dood"
  clock data
  clock settle
  clock data
  expect state onRoute == "settings"
  expect tree has "settings-nav-settings"
  expect tree missing "profile-body"
  tap "settings-go-permissions-settings"
  clock data
  clock settle
  expect state onRoute == "permissions"
