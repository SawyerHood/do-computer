  tap "go-profile-dood"
  clock data
  clock settle
  clock data
  type "profile-name" "Maple"
  tap "settings-go-memory-profile"
  clock data
  clock settle
  type "memory-text" "Knows Maple's name."
  tap "settings-go-profile-memory"
