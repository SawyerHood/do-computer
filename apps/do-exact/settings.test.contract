  tap "go-profile-dood"
  clock data
  clock settle
  tap "settings-go-model-profile"
  clock data
  clock settle
  clock data
  expect state onRoute == "model"
  expect text "heading-model" == "Model and computers"
  expect text "model-picker-value" == "Echo (no model key configured)"
  tap "model-picker"
  clock settle
  type "model-picker-search" "echo"
  expect tree has "model-picker-option-echo/echo-1"
  type "model-picker-search" "nothing like it"
  expect tree missing "model-picker-option-echo/echo-1"
  expect state doodComputers.usable.length == 1
  expect tree missing "model-no-computers"

test "a rule for what a Dood may do is set and kept, and its usage says there is none yet"
  size 1280x800
  tap "sign-toggle"
  type "sign-name" "Ada"
  type "sign-email" "settings-7@example.com"
  type "sign-password" "correct horse"
  tap "sign-submit"
  clock data
  tap "new-dood"
  clock data
  clock settle
  clock data
  tap "pages-dood"
  tap "go-permissions-dood"
  clock data
  clock settle
  clock data
  expect state onRoute == "permissions"
  expect text "heading-permissions" == "Permissions"
  expect tree has "rule-tool:bash"
  tap "rule-tool:bash-ask"
  clock data
  expect state approvals.subjects.0 .rule == "ask"
  reload
  clock data
  clock settle
  clock data
  expect state approvals.subjects.0 .rule == "ask"
  tap "settings-go-usage-permissions"
  clock data
  clock settle
  clock data
  expect text "usage-nothing" == "Nothing yet."

test "a Dood is deleted only once its name is typed, and the app goes back to the list"
  size 1280x800
  tap "sign-toggle"
  type "sign-name" "Ada"
  type "sign-email" "settings-8@example.com"
  type "sign-password" "correct horse"
  tap "sign-submit"
  clock data
  tap "new-dood"
  clock data
  clock settle
  clock data
  tap "pages-dood"
  tap "go-profile-dood"
  clock data
  clock settle
  clock data
  expect text "profile-move-nowhere" == "Start a team with New team, at the foot of the sidebar, to have somewhere to move it."
  tap "profile-delete-open"
  type "profile-delete-typed" "something else"
  expect disabled "profile-delete-confirm"
  tap "profile-delete-cancel"
  expect tree missing "profile-delete-typed"
  tap "profile-delete-open"
  type "profile-delete-typed" "delete"
  tap "profile-delete-confirm"
  clock data
  clock settle
  clock data
  expect state onRoute == "doods"
  expect state doods.doods.length == 0

test "a phone shows a Dood's sections as a list, a section over it, and the cross goes back to its chat"
