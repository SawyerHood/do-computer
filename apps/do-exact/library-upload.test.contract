test "uploads open as a document, sandboxed page, table, code, picture, PDF and download"
  tap "sign-toggle"
  type "sign-name" "Ada"
  type "sign-email" "library-upload-1@example.com"
  type "sign-password" "correct horse"
  tap "sign-submit"
  clock data
  tap "new-dood"
  clock data
  clock settle
  clock data
  tap "pages-dood"
  tap "go-library-dood"
  clock data
  tap "library-upload-button"
  pick "library-upload" "fixtures/library/report.md" "fixtures/library/index.html" "fixtures/library/data.csv" "fixtures/library/example.ts" "fixtures/library/picture.png" "fixtures/library/paper.pdf" "fixtures/library/unknown.bin"
  clock data
  expect state libraryFiles.length == 7
  type "library-filter" "report.md"
  tap "Open report.md"
  clock data
  clock settle
  clock data
  expect tree has "library-markdown"
  tap "library-home"
  clock data
  type "library-filter" "index.html"
  tap "Open index.html"
  clock data
  clock settle
  clock data
  expect tree has "library-page"
  tap "library-page-reload"
  tap "library-mode-source"
  clock data
  expect tree has "library-editor"
  tap "library-home"
  clock data
  type "library-filter" "data.csv"
  tap "Open data.csv"
  clock data
  clock settle
  clock data
  expect tree has "library-table"
  tap "library-home"
  clock data
  type "library-filter" "example.ts"
  tap "Open example.ts"
  clock data
  clock settle
  clock data
  expect text "library-editor" == "const answer = 42;\n"
  tap "library-home"
  clock data
  type "library-filter" "picture.png"
  tap "Open picture.png"
  clock data
  clock settle
  clock data
  tap "library-picture-open"
  expect tree has "library-picture"
  tap "library-picture-close"
  tap "library-home"
  clock data
  type "library-filter" "paper.pdf"
  tap "Open paper.pdf"
  clock data
  clock settle
  clock data
  expect tree has "library-pdf"
  tap "library-home"
  clock data
  type "library-filter" "unknown.bin"
  tap "Open unknown.bin"
  clock data
  clock settle
  clock data
  expect tree has "library-other-download"
