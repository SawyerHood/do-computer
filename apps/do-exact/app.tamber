  icon.arrows-out = icon(sf "arrow.up.left.and.arrow.down.right", svg "icons/arrows-out.svg")
  icon.phone = icon(sf "phone", svg "icons/phone.svg")
  icon.terminal = icon(sf "terminal", svg "icons/terminal.svg")
  icon.archive = icon(sf "archivebox", svg "icons/archive.svg")
  icon.arrow-square-out = icon(sf "arrow.up.right.square", svg "icons/arrow-square-out.svg")
  icon.monitor = icon(sf "display", svg "icons/monitor.svg")
  // --- library, pins and sharing ---
  icon.folder = icon(sf "folder", svg "icons/folder.svg")
  icon.folder-open = icon(sf "folder", svg "icons/folder-open.svg")
  icon.file-text = icon(sf "doc.text", svg "icons/file-text.svg")
  icon.file-image = icon(sf "photo", svg "icons/file-image.svg")
  icon.file-code = icon(sf "chevron.left.forwardslash.chevron.right", svg "icons/file-code.svg")
  icon.table = icon(sf "tablecells", svg "icons/table.svg")
  icon.note-pencil = icon(sf "square.and.pencil", svg "icons/note-pencil.svg")
  icon.upload = icon(sf "arrow.up.to.line", svg "icons/upload.svg")
  icon.share-network = icon(sf "square.and.arrow.up", svg "icons/share-network.svg")
  icon.cloud-check = icon(sf "checkmark.icloud", svg "icons/cloud-check.svg")
  icon.link = icon(sf "link", svg "icons/link.svg")
  icon.push-pin-slash = icon(sf "pin.slash", svg "icons/push-pin-slash.svg")
  icon.trash = icon(sf "trash", svg "icons/trash.svg")
  icon.clock-counter-clockwise = icon(sf "clock.arrow.circlepath", svg "icons/clock-counter-clockwise.svg")
  icon.pencil = icon(sf "pencil", svg "icons/pencil.svg")
