{
  "name": "@do-computer/web",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "pnpm generate && vite dev --port 3000",
    "dev:cloudflare": "pnpm generate && DC_TARGET=cloudflare vite dev --port 3000",
    "build": "pnpm generate && vite build && DC_TARGET=cloudflare vite build",
    "build:node": "pnpm generate && vite build",
    "build:packed": "pnpm generate && node scripts/build-packed.mjs",
    "build:cloudflare": "pnpm generate && DC_TARGET=cloudflare vite build",
    "start": "node server.node.mjs",
    "deploy": "pnpm build:cloudflare && node scripts/deploy-settings.mjs && wrangler deploy",
    "check": "pnpm generate && tsc --noEmit && tsc --noEmit -p tsconfig.cloudflare.json",
    "test": "vitest run",
    "test:e2e": "pnpm build:node && pnpm --filter @do-computer/mobile export:web:test && playwright test",
    "generate": "pnpm --filter @do-computer/daemon build",
    "theme": "node scripts/theme-tokens.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@better-auth/expo": "^1.7.7",
    "@daytona/sdk": "^0.223.1",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@do-computer/agent": "workspace:*",
    "@do-computer/client": "workspace:*",
    "@do-computer/computers": "workspace:*",
    "@do-computer/mascot": "workspace:*",
    "@do-computer/protocol": "workspace:*",
    "@do-computer/runtime": "workspace:*",
    "@do-computer/sandbox": "workspace:*",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@phosphor-icons/react": "^2.1.10",
    "@shadcn/react": "^0.3.1",
    "@tanstack/db": "^0.13.0",
    "@tanstack/query-db-collection": "^1.4.3",
    "@tanstack/react-db": "^0.5.8",
    "@tanstack/react-query": "^5.104.2",
    "@tanstack/react-router": "^1.170.42",
    "@tanstack/react-start": "^1.168.61",
    "better-auth": "^1.7.7",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "jotai": "^3.0.1",
    "mermaid": "^12.1.0",
    "modal": "^0.11.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-markdown": "^10.1.0",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "shadcn": "^4.21.4",
    "shiki": "^4.5.0",
    "srvx": "^1.0.5",
    "tailwind-merge": "^3.7.0",
    "three": "0.128.0",
    "tw-animate-css": "^1.4.0",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.63.1",
    "@cloudflare/workers-types": "^5.20261011.1",
    "@playwright/test": "^1.64.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "catalog:",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "0.128.0",
    "@types/ws": "^8.18.2",
    "@typescript/native": "catalog:",
    "@vitejs/plugin-react": "^6.1.2",
    "tailwindcss": "^4.3.3",
