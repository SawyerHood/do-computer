{
  "name": "@durable-computer/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm generate && vite dev --port 3000",
    "dev:cloudflare": "pnpm generate && DC_TARGET=cloudflare vite dev --port 3000",
    "build": "pnpm generate && vite build && DC_TARGET=cloudflare vite build",
    "build:node": "pnpm generate && vite build",
    "build:cloudflare": "pnpm generate && DC_TARGET=cloudflare vite build",
    "start": "node server.node.mjs",
    "deploy": "pnpm build:cloudflare && wrangler deploy",
    "check": "pnpm generate && tsc --noEmit && tsc --noEmit -p tsconfig.cloudflare.json",
    "test": "vitest run",
    "test:e2e": "pnpm build:node && pnpm --filter @durable-computer/mobile export:web:test && playwright test",
    "generate": "pnpm --filter @durable-computer/daemon build"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@better-auth/expo": "^1.7.7",
    "@durable-computer/agent": "workspace:*",
    "@durable-computer/client": "workspace:*",
    "@durable-computer/computers": "workspace:*",
    "@durable-computer/protocol": "workspace:*",
    "@durable-computer/runtime": "workspace:*",
    "@durable-computer/sandbox": "workspace:*",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@phosphor-icons/react": "^2.1.10",
    "@shadcn/react": "^0.3.1",
    "@tanstack/db": "^0.11.0",
    "@tanstack/query-db-collection": "^1.3.1",
    "@tanstack/react-db": "^0.5.0",
    "@tanstack/react-query": "^5.104.0",
    "@tanstack/react-router": "^1.170.41",
    "@tanstack/react-start": "^1.168.60",
    "better-auth": "^1.7.7",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "jotai": "^3.0.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "shadcn": "^4.21.0",
    "srvx": "^1.0.5",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.62.4",
    "@cloudflare/workers-types": "^5.20261001.1",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "catalog:",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/ws": "^8.18.2",
    "@typescript/native": "catalog:",
    "@vitejs/plugin-react": "^6",
    "tailwindcss": "^4.3.3",
    "typescript": "catalog:",
    "vite": "^8.3.2",
    "vitest": "catalog:",
    "wrangler": "^4.146.0"
  }
}
