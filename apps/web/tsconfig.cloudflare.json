{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "types": ["vite/client", "node", "@cloudflare/workers-types"],
    "paths": {
      "@/*": ["./src/*"],
      "#platform": ["./src/server/platform.cloudflare.ts"]
