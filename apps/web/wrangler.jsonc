{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "durable-computer",
  "main": "./src/server.cloudflare.ts",
  "compatibility_date": "2026-08-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  "durable_objects": {
    "bindings": [
      { "name": "AGENT", "class_name": "AgentObject" },
      { "name": "COMPUTER", "class_name": "ComputerObject" },
      { "name": "SANDBOX", "class_name": "SandboxObject" },
      { "name": "SHELL", "class_name": "ShellObject" },
      { "name": "PRESENCE", "class_name": "PresenceObject" },
      { "name": "LIBRARY", "class_name": "LibraryObject" },
      { "name": "MODEL_ACCESS", "class_name": "ModelAccessObject" },
    ],
  },
  // The built-in shell runs each agent's commands in a Worker of its own, started through this
  // (Dynamic Workers, on the Workers Paid plan).
  "worker_loaders": [{ "binding": "LOADER" }],
  // To give each agent a Linux machine on Cloudflare Containers (Workers Paid plan), uncomment
  // this and set DC_SANDBOX to "cloudflare" in `vars`. The machine starts from Cloudflare's
  // managed Debian image, so there is nothing to build.
  // "containers": [{ "class_name": "SandboxObject", "scheduling_policy": "durable_object" }],
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["AgentObject"] },
    { "tag": "v2", "new_sqlite_classes": ["ComputerObject"] },
    { "tag": "v3", "new_sqlite_classes": ["SandboxObject"] },
    { "tag": "v4", "new_sqlite_classes": ["PresenceObject"] },
    { "tag": "v5", "new_sqlite_classes": ["LibraryObject"] },
    { "tag": "v6", "new_sqlite_classes": ["ModelAccessObject"] },
    { "tag": "v7", "new_sqlite_classes": ["ShellObject"] },
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "durable-computer",
      // Replace with the id printed by `wrangler d1 create durable-computer`.
      "database_id": "00000000-0000-0000-0000-000000000000",
    },
  ],
  "r2_buckets": [{ "binding": "BLOBS", "bucket_name": "durable-computer" }],
  // How often one address may sign in, sign up or ask to pair a computer: the calls that need no
  // account (src/server/rate-limit.ts). Counted per Cloudflare location, and not exactly. The
  // namespace id is any number no other Worker on the account uses for something else.
  "ratelimits": [
    { "name": "PUBLIC_LIMIT", "namespace_id": "20261010", "simple": { "limit": 20, "period": 60 } },
  ],
  "vars": { "DC_SIGNUP": "invite" },
  // Secrets (wrangler secret put): DC_AUTH_SECRET, OPENROUTER_API_KEY, and optionally
  // GOOGLE_CLIENT_ID, GOOGLE_CLIENT_SECRET, GITHUB_CLIENT_ID, GITHUB_CLIENT_SECRET, and
  // RESEND_API_KEY to send team invitations by email (with DC_EMAIL_FROM in `vars`).
}
