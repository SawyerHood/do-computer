    "better-auth": "^1.7.7",
    "expo": "~57.0.26",
    "expo-audio": "~57.0.5",
    "expo-constants": "~57.0.20",
    "expo-crypto": "~57.0.3",
    "expo-device": "~57.0.2",
    "expo-document-picker": "~57.0.3",
    "expo-file-system": "~57.0.7",
    "expo-linking": "~57.0.11",
    "expo-notifications": "~57.0.21",
    "expo-router": "~57.0.24",
    "expo-secure-store": "~57.0.4",
    "expo-sharing": "~57.0.22",
    "expo-status-bar": "~57.0.1",
