{
  "name": "@durable-computer/mobile",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "ios": "expo start --ios",
    "android": "expo start --android",
    "web": "expo start --web",
    "export": "expo export --platform ios --platform android",
    "export:web": "expo export --platform web",
    "check": "tsc --noEmit",
    "test": "vitest run",
    "export:web:test": "DC_MOBILE_BASE_URL=/__mobile expo export --platform web --output-dir dist-web-test"
  },
