{
  "name": "@do-computer/desktop",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "description": "Do Computer on your desktop: the app in a window of its own, and the daemon that lets your agents work on this computer.",
  "author": "Do Computer",
  "type": "module",
  "main": "dist/main.cjs",
  "scripts": {
    "build": "pnpm --filter @do-computer/daemon build && node build.mjs",
    "start": "pnpm build && electron .",
    "check": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "package": "pnpm build && electron-builder --publish never --config electron-builder.unsigned.yml"
  },
  "devDependencies": {
    "@do-computer/computers": "workspace:*",
    "@do-computer/daemon": "workspace:*",
    "@do-computer/protocol": "workspace:*",
    "@playwright/test": "^1.64.0",
    "@trycua/cua-driver": "0.34.1",
    "@types/node": "catalog:",
    "@typescript/native": "catalog:",
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3",
    "electron-updater": "^6.8.9",
    "esbuild": "^0.28.2",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
