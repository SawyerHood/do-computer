{
  "name": "do-computer",
  "private": true,
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@11.15.0",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "dev": "pnpm --filter @do-computer/web dev",
    "dev:cloudflare": "pnpm --filter @do-computer/web dev:cloudflare",
    "build": "pnpm --filter @do-computer/web build",
    "start": "pnpm --filter @do-computer/web start",
    "deploy": "pnpm --filter @do-computer/web run deploy",
    "check": "pnpm -r run check",
    "test": "pnpm -r run test",
    "test:e2e": "pnpm --filter @do-computer/web test:e2e",
    "format": "prettier --write .",
    "mobile": "pnpm --filter @do-computer/mobile start",
    "desktop": "pnpm --filter @do-computer/desktop start"
  },
  "devDependencies": {
    "prettier": "^3.8.3",
    "typescript": "catalog:",
    "@typescript/native": "catalog:"
  }
}
