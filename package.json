{
  "name": "durable-computer",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.15.0",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "dev": "pnpm --filter @durable-computer/web dev",
    "dev:cloudflare": "pnpm --filter @durable-computer/web dev:cloudflare",
