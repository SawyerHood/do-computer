{
  "name": "dc-sandbox-test",
  "main": "./worker.ts",
  "compatibility_date": "2026-08-01",
  "compatibility_flags": ["nodejs_compat"],
  "worker_loaders": [{ "binding": "LOADER" }],
  "durable_objects": {
    "bindings": [
      { "name": "SHELL", "class_name": "ShellObject" },
      { "name": "QUIET", "class_name": "QuietShellObject" },
    ],
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["ShellObject", "QuietShellObject"] }],
}
