{
  "name": "dc-agent-test",
  "main": "./worker.ts",
  "compatibility_date": "2026-08-01",
  "compatibility_flags": ["nodejs_compat"],
  "durable_objects": { "bindings": [{ "name": "AGENT", "class_name": "AgentObject" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["AgentObject"] }],
  "r2_buckets": [{ "binding": "BLOBS", "bucket_name": "dc-agent-test" }],
}
