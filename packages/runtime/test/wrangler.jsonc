{
  "name": "dc-runtime-conformance",
  "main": "./worker.ts",
  "compatibility_date": "2026-08-01",
  "compatibility_flags": ["nodejs_compat"],
  "durable_objects": { "bindings": [{ "name": "ACTOR", "class_name": "ConformanceActor" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["ConformanceActor"] }],
  "r2_buckets": [{ "binding": "BLOBS", "bucket_name": "dc-conformance" }],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "dc-conformance",
      "database_id": "00000000-0000-0000-0000-000000000000",
    },
  ],
}
